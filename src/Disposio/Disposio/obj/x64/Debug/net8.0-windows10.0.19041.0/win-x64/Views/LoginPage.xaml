<Page
    x:Class="Disposio.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <LinearGradientBrush x:Key="AppBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0B0D12" Offset="0"/>
            <GradientStop Color="#13161A" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FFFF4D5A" />
        <SolidColorBrush x:Key="PanelBrush" Color="#26292D" />
        <SolidColorBrush x:Key="PanelDarkBrush" Color="#1B1E23" />
        <SolidColorBrush x:Key="TextMain" Color="#E6E9F0" />
        <SolidColorBrush x:Key="TextMuted" Color="#9CA3AF" />
        <SolidColorBrush x:Key="InputBackground" Color="#FF222426" />
        <SolidColorBrush x:Key="InputBorder" Color="#FF2F313A" />
        <SolidColorBrush x:Key="ButtonTextOnPrimary" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="SpeechBubbleBackground" Color="#FF222429" />
        <SolidColorBrush x:Key="SpeechBorderBrush" Color="#FF2F313A" />
    </Page.Resources>

    <Grid Background="{StaticResource AppBackground}">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="1100" Height="620" CornerRadius="12" Background="#0F111417" BorderBrush="#2a2c31" BorderThickness="1">
                <!-- inner split -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- left panel -->
                    <Border Grid.Column="0" Background="{StaticResource PanelDarkBrush}" Padding="36" CornerRadius="12,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- header: title + controls -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <!-- Linke Spalte bekommt eine Mindestbreite -->
                                    <ColumnDefinition MinWidth="200" Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Linker Bereich -->
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="DISPOSIO"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}" />
                                    <TextBlock Text="UNTERNEHMENSPORTAL"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMuted}"
                                       Margin="0,8,0,0" />          
                                    </StackPanel>

                                <!-- Rechter Bereich -->
                                <!-- color selector and mode toggle moved to right panel -->
                            </Grid>


                            <!-- title -->
                            <StackPanel Grid.Row="1" Margin="0,18,0,8">
                                <TextBlock Text="Willkommen zurück" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" />
                            </StackPanel>

                            <!-- form -->
                            <StackPanel Grid.Row="2" Spacing="10" Margin="0 30 0 0">
                                <TextBlock Text="Unternehmenskennung *" Foreground="{StaticResource TextMain}" FontSize="12" />
                                <TextBox x:ConnectionId='5' x:Name="CompanyBox" PlaceholderText="z. B. nordlog" Background="{StaticResource InputBackground}" Foreground="{StaticResource TextMain}" BorderBrush="{StaticResource InputBorder}" CornerRadius="8" Height="40"/>

                                <TextBlock Text="E‑Mail‑Adresse *" Foreground="{StaticResource TextMain}" FontSize="12" Margin="0,8,0,0" />
                                <TextBox x:ConnectionId='6' x:Name="EmailBox" PlaceholderText="demo@beispiel.invalid" Background="{StaticResource InputBackground}" Foreground="{StaticResource TextMain}" BorderBrush="{StaticResource InputBorder}" CornerRadius="8" Height="40"/>

                                <TextBlock Text="Passwort *" Foreground="{StaticResource TextMain}" FontSize="12" Margin="0,8,0,0" />
                                <PasswordBox x:ConnectionId='7' x:Name="PasswordBox" PlaceholderText="••••••••" Background="{StaticResource InputBackground}" Foreground="{StaticResource TextMain}" BorderBrush="{StaticResource InputBorder}" CornerRadius="8" Height="40"/>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                                    <CheckBox Content="Angemeldet bleiben" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- footer button -->
                            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                                <Border CornerRadius="10" Background="{StaticResource PrimaryBrush}" Height="52">
                                    <Button x:ConnectionId='4' x:Name="LoginButton" Content="Anmelden" Background="Transparent" Foreground="{StaticResource ButtonTextOnPrimary}" FontWeight="SemiBold"                          />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- divider -->
                    <Border Grid.Column="0" HorizontalAlignment="Right" Width="1" Background="#2a2c31"/>

                    <!-- right panel -->
                    <Grid Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="0,12,12,0">
                        <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="18,18,0,0"
                            Spacing="250">
                            <ComboBox x:ConnectionId='2' x:Name="ColorCombo"
                                  Width="120"
                                                                                >
                                <ComboBoxItem Tag="#FF004D" IsSelected="True">Rot</ComboBoxItem>
                                <ComboBoxItem Tag="#7B2CBF">Lila</ComboBoxItem>
                                <ComboBoxItem Tag="#007BFF">Blau</ComboBoxItem>
                                <ComboBoxItem Tag="#00C853">Grün</ComboBoxItem>
                                <ComboBoxItem Tag="#FF9100">Orange</ComboBoxItem>
                            </ComboBox>

                            <ToggleSwitch x:ConnectionId='3' x:Name="ModeSwitch"
                                                              
                                  OffContent="Dark Mode"
                                  OnContent="Light Mode"/>
                        </StackPanel>

                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- speech bubble in left column, aligned to mascot head by translate transform -->
                            <Grid HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-70,0,0,0">
                                <Grid HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <TranslateTransform Y="-80" />
                                    </Grid.RenderTransform>

                                    <Border Background="{StaticResource SpeechBubbleBackground}"
                BorderBrush="{StaticResource SpeechBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12,10"
                HorizontalAlignment="Left">
                                        <TextBlock Text="Passwort vergessen?"
                       Foreground="{StaticResource TextMain}"
                       FontSize="13"/>
                                    </Border>

                                </Grid>
                            </Grid>
                            <!-- mascot image in right column, keep centered -->
                            <Image Source="ms-appx:///Assets/miseur_kofferfell.png" Width="360" Height="360" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>

