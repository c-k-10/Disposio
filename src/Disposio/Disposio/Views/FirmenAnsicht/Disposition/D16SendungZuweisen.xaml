<?xml version="1.0" encoding="utf-8"?>
<!-- D16 „Sendung zuweisen“ (aus D02 „Zuweisen“): zeigt die Sendung und alle Fahrer und Fahrzeuge, die im Zeitraum
     der Sendung frei sind. Nach der Auswahl wird daraus eine neue Tour mit Abhol- und Zustellstopp (Status „Zugewiesen“). -->
<UserControl
    x:Class="Disposio.Views.D16SendungZuweisen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Disposio.Views">

    <StackPanel Spacing="18">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <ProgressRing x:Name="LadeAnzeige" Width="20" Height="20" IsActive="True" />
            <TextBlock x:Name="LadeText" Style="{StaticResource HinweisText}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Text="Sendung, freie Fahrer und Fahrzeuge werden geladen …" />
        </StackPanel>

        <!-- 1. Die Sendung -->
        <Border Style="{StaticResource KarteStyle}">
            <StackPanel Spacing="14">
                <TextBlock x:Name="SendungTitel" Text="Sendung" Style="{StaticResource UeberschriftText}" />
                <Grid ColumnSpacing="24" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Abholung" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                        <TextBlock x:Name="AbholungZeit" Style="{StaticResource NormalText}" FontWeight="SemiBold" />
                        <TextBlock x:Name="AbholungAdresse" Style="{StaticResource NormalText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Zustellung" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                        <TextBlock x:Name="ZustellungZeit" Style="{StaticResource NormalText}" FontWeight="SemiBold" />
                        <TextBlock x:Name="ZustellungAdresse" Style="{StaticResource NormalText}" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="LadegutText" Style="{StaticResource NormalText}" />
            </StackPanel>
        </Border>

        <!-- 2. Ablageflächen: Fahrer und Fahrzeug per Drag &amp; Drop hierher ziehen (oder in der Liste anklicken). -->
        <Border Style="{StaticResource KarteStyle}">
            <StackPanel Spacing="14">
                <TextBlock Text="Zuweisung" Style="{StaticResource UeberschriftText}" />
                <TextBlock Style="{StaticResource HinweisText}"
                           Text="Ziehen Sie einen Fahrer und ein Fahrzeug aus den Listen unten in die Felder. Anklicken in der Liste geht auch." />
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                <Grid x:Name="FahrerSlot" AllowDrop="True" MinHeight="96" Background="Transparent"
                      DragOver="FahrerSlot_DragOver" DragLeave="Slot_DragLeave" Drop="FahrerSlot_Drop"
                      AutomationProperties.Name="Fahrer">
                    <!-- Gestrichelter Rahmen als Ablagefläche. Beim Darüberziehen wird er in der Akzentfarbe hervorgehoben. -->
                    <Rectangle x:Name="FahrerRahmen" RadiusX="14" RadiusY="14" StrokeThickness="2" StrokeDashArray="4,3"
                               Stroke="{StaticResource BorderBrush}" Fill="Transparent" />
                    <Grid Padding="18,14" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE77B;" FontSize="22" VerticalAlignment="Center"
                                  Foreground="{StaticResource MutedTextBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Fahrer" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                            <TextBlock x:Name="FahrerSlotName" Style="{StaticResource NormalText}" FontWeight="SemiBold" Text="Fahrer hierher ziehen" />
                            <TextBlock x:Name="FahrerSlotDetails" Style="{StaticResource HinweisText}" Visibility="Collapsed" />
                        </StackPanel>
                        <Button x:Name="FahrerEntfernen" Grid.Column="2" Content="✕" Visibility="Collapsed" VerticalAlignment="Center"
                                Style="{StaticResource DashboardButton}" MinHeight="36" Padding="12,4" Click="FahrerEntfernen_Click"
                                ToolTipService.ToolTip="Auswahl entfernen" AutomationProperties.Name="Fahrer entfernen" />
                    </Grid>
                </Grid>
                    <Grid Grid.Column="1">
                <Grid x:Name="FahrzeugSlot" AllowDrop="True" MinHeight="96" Background="Transparent"
                      DragOver="FahrzeugSlot_DragOver" DragLeave="Slot_DragLeave" Drop="FahrzeugSlot_Drop"
                      AutomationProperties.Name="Fahrzeug">
                    <!-- Gestrichelter Rahmen als Ablagefläche. Beim Darüberziehen wird er in der Akzentfarbe hervorgehoben. -->
                    <Rectangle x:Name="FahrzeugRahmen" RadiusX="14" RadiusY="14" StrokeThickness="2" StrokeDashArray="4,3"
                               Stroke="{StaticResource BorderBrush}" Fill="Transparent" />
                    <Grid Padding="18,14" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE804;" FontSize="22" VerticalAlignment="Center"
                                  Foreground="{StaticResource MutedTextBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Fahrzeug" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                            <TextBlock x:Name="FahrzeugSlotName" Style="{StaticResource NormalText}" FontWeight="SemiBold" Text="Fahrzeug hierher ziehen" />
                            <TextBlock x:Name="FahrzeugSlotDetails" Style="{StaticResource HinweisText}" Visibility="Collapsed" />
                        </StackPanel>
                        <Button x:Name="FahrzeugEntfernen" Grid.Column="2" Content="✕" Visibility="Collapsed" VerticalAlignment="Center"
                                Style="{StaticResource DashboardButton}" MinHeight="36" Padding="12,4" Click="FahrzeugEntfernen_Click"
                                ToolTipService.ToolTip="Auswahl entfernen" AutomationProperties.Name="Fahrzeug entfernen" />
                    </Grid>
                </Grid>
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3. Freie Fahrer und Fahrzeuge -->
        <Grid ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource KarteStyle}">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="FahrerTitel" Text="Freie Fahrer" Style="{StaticResource UeberschriftText}" />
                    <ListView x:Name="FahrerListe" SelectionMode="Single" MaxHeight="460" Margin="-4,0"
                              CanDragItems="True" DragItemsStarting="Liste_DragItemsStarting" DragItemsCompleted="Liste_DragItemsCompleted"
                              SelectionChanged="Auswahl_SelectionChanged" AutomationProperties.Name="Freie Fahrer">
                        <ListView.ItemContainerStyle>
                            <!-- Abstand zwischen den Karten, Karte über die ganze Breite -->
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="4,0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:FahrerZeile">
                                <!-- Jeder Eintrag als Karte mit Griff links: zeigt, dass man ihn ziehen oder anklicken kann. -->
                                <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="10,10,14,10"
                                        ToolTipService.ToolTip="Ins Feld „Fahrer“ ziehen oder anklicken">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE784;" FontSize="16" VerticalAlignment="Center"
                                                  Foreground="{StaticResource MutedTextBrush}" />
                                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="19" VerticalAlignment="Center"
                                                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <FontIcon Glyph="&#xE77B;" FontSize="17" Foreground="{StaticResource TextBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource NormalText}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Details}" Style="{StaticResource HinweisText}" FontSize="13" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="FahrerLeerText" Style="{StaticResource HinweisText}" Visibility="Collapsed"
                               Text="Im Zeitraum der Sendung ist kein Fahrer frei." />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource KarteStyle}">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="FahrzeugTitel" Text="Freie Fahrzeuge" Style="{StaticResource UeberschriftText}" />
                    <ListView x:Name="FahrzeugListe" SelectionMode="Single" MaxHeight="460" Margin="-4,0"
                              CanDragItems="True" DragItemsStarting="Liste_DragItemsStarting" DragItemsCompleted="Liste_DragItemsCompleted"
                              SelectionChanged="Auswahl_SelectionChanged" AutomationProperties.Name="Freie Fahrzeuge">
                        <ListView.ItemContainerStyle>
                            <!-- Abstand zwischen den Karten, Karte über die ganze Breite -->
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="4,0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:FahrzeugAuswahlZeile">
                                <!-- Jeder Eintrag als Karte mit Griff links: zeigt, dass man ihn ziehen oder anklicken kann. -->
                                <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="10,10,14,10"
                                        ToolTipService.ToolTip="Ins Feld „Fahrzeug“ ziehen oder anklicken">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE784;" FontSize="16" VerticalAlignment="Center"
                                                  Foreground="{StaticResource MutedTextBrush}" />
                                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="19" VerticalAlignment="Center"
                                                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <FontIcon Glyph="&#xE804;" FontSize="17" Foreground="{StaticResource TextBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Titel}" Style="{StaticResource NormalText}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Details}" Style="{StaticResource HinweisText}" FontSize="13" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="FahrzeugLeerText" Style="{StaticResource HinweisText}" Visibility="Collapsed"
                               Text="Im Zeitraum der Sendung ist kein passendes Fahrzeug frei." />
                    <!-- Freie, aber unpassende Fahrzeuge (z. B. ohne Kühlung) mit Grund -->
                    <TextBlock x:Name="UnpassendText" Style="{StaticResource HinweisText}" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4. Die neue Tour -->
        <Border Style="{StaticResource KarteStyle}">
            <StackPanel Spacing="14">
                <TextBlock Text="Neue Tour" Style="{StaticResource UeberschriftText}" />
                <TextBlock x:Name="TourHinweis" Style="{StaticResource HinweisText}" />
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Tournummer *" Style="{StaticResource FeldLabel}" />
                        <TextBox x:Name="TournummerBox" Style="{StaticResource FormTextBox}" MaxLength="30"
                                 AutomationProperties.Name="Tournummer" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Bereich / Abteilung *" Style="{StaticResource FeldLabel}" />
                        <ComboBox x:Name="AbteilungBox" Style="{StaticResource FormComboBox}" PlaceholderText="Bitte wählen"
                                  AutomationProperties.Name="Bereich" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock x:Name="AuswahlText" Style="{StaticResource HinweisText}" Text="Bitte einen Fahrer und ein Fahrzeug auswählen." />
        <TextBlock x:Name="FehlerText" Style="{StaticResource FehlerText}" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <Button Content="Abbrechen" Style="{StaticResource DashboardButton}" Click="Abbrechen_Click" />
            <Button x:Name="ZuweisenButton" Content="Tour anlegen &amp; zuweisen" Style="{StaticResource PrimaryButton}"
                    IsEnabled="False" Click="Zuweisen_Click" />
        </StackPanel>
    </StackPanel>
</UserControl>
