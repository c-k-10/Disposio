<?xml version="1.0" encoding="utf-8"?>
<!-- D05 „Tour planen“ als Assistent in 4 Schritten: 1 Tourdaten, 2 Sendungen & Stopps (offene Sendungen übernehmen –
     je ein Abhol- und Zustellstopp –, eigene Stopps, Reihenfolge), 3 Fahrer & Fahrzeug (optional), 4 Prüfen & speichern.
     Fehlerhafte Felder werden rot umrandet wie in D03. -->
<UserControl
    x:Class="Disposio.Views.D05TourPlanen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Disposio.Views">

    <UserControl.Resources>
        <!-- Flacher Knopf für die Schrittliste: ohne Rahmen, ganze Breite, Text links. -->
        <Style x:Key="AbschnittKnopf" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="6,9,12,9" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="18">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <ProgressRing x:Name="LadeAnzeige" Width="20" Height="20" IsActive="True" />
            <TextBlock x:Name="LadeText" Style="{StaticResource HinweisText}" VerticalAlignment="Center"
                       Text="Formular wird geladen …" />
        </StackPanel>

        <!-- Links die Schritte, rechts immer nur der aktuelle Schritt.
             Punkt links: grünes ✓ = vollständig, rotes „!“ = Fehler, Akzentfarbe = aktueller Schritt. -->
        <Grid ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Top" Spacing="4">
                <TextBlock Text="Schritte" Style="{StaticResource HinweisText}" FontSize="13" Margin="12,0,0,6" />
                <Button x:Name="NavSchritt1" Style="{StaticResource AbschnittKnopf}" Click="Schritt_Click"
                        AutomationProperties.Name="Schritt 1: Tourdaten">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle x:Name="NavSchritt1Balken" Fill="{StaticResource AccentBrush}" RadiusX="2" RadiusY="2" Opacity="0" />
                        <Grid Grid.Column="1" Width="24" Height="24" VerticalAlignment="Center">
                            <Ellipse x:Name="NavSchritt1Punkt" StrokeThickness="1.5" />
                            <TextBlock x:Name="NavSchritt1Symbol" Text="1" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Grid.Column="2" Text="Tourdaten" FontSize="15" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                    </Grid>
                </Button>
                <Button x:Name="NavSchritt2" Style="{StaticResource AbschnittKnopf}" Click="Schritt_Click"
                        AutomationProperties.Name="Schritt 2: Sendungen &amp; Stopps">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle x:Name="NavSchritt2Balken" Fill="{StaticResource AccentBrush}" RadiusX="2" RadiusY="2" Opacity="0" />
                        <Grid Grid.Column="1" Width="24" Height="24" VerticalAlignment="Center">
                            <Ellipse x:Name="NavSchritt2Punkt" StrokeThickness="1.5" />
                            <TextBlock x:Name="NavSchritt2Symbol" Text="2" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Grid.Column="2" Text="Sendungen &amp; Stopps" FontSize="15" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                    </Grid>
                </Button>
                <Button x:Name="NavSchritt3" Style="{StaticResource AbschnittKnopf}" Click="Schritt_Click"
                        AutomationProperties.Name="Schritt 3: Fahrer &amp; Fahrzeug">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle x:Name="NavSchritt3Balken" Fill="{StaticResource AccentBrush}" RadiusX="2" RadiusY="2" Opacity="0" />
                        <Grid Grid.Column="1" Width="24" Height="24" VerticalAlignment="Center">
                            <Ellipse x:Name="NavSchritt3Punkt" StrokeThickness="1.5" />
                            <TextBlock x:Name="NavSchritt3Symbol" Text="3" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Grid.Column="2" Text="Fahrer &amp; Fahrzeug" FontSize="15" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                    </Grid>
                </Button>
                <Button x:Name="NavSchritt4" Style="{StaticResource AbschnittKnopf}" Click="Schritt_Click"
                        AutomationProperties.Name="Schritt 4: Prüfen &amp; speichern">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle x:Name="NavSchritt4Balken" Fill="{StaticResource AccentBrush}" RadiusX="2" RadiusY="2" Opacity="0" />
                        <Grid Grid.Column="1" Width="24" Height="24" VerticalAlignment="Center">
                            <Ellipse x:Name="NavSchritt4Punkt" StrokeThickness="1.5" />
                            <TextBlock x:Name="NavSchritt4Symbol" Text="4" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Grid.Column="2" Text="Prüfen &amp; speichern" FontSize="15" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                    </Grid>
                </Button>
                <TextBlock x:Name="FortschrittText" Style="{StaticResource HinweisText}" FontSize="13"
                           TextWrapping="Wrap" Margin="12,10,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="18">
        <!-- Kopf des aktuellen Schritts -->
        <StackPanel x:Name="SchrittKopf" Spacing="2">
            <TextBlock x:Name="SchrittZaehler" Style="{StaticResource HinweisText}" FontSize="13" Text="Schritt 1 von 4" />
            <TextBlock x:Name="SchrittTitel" Style="{StaticResource UeberschriftText}" Text="Tourdaten" />
            <TextBlock x:Name="SchrittHinweis" Style="{StaticResource HinweisText}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Schritt 1: Tourdaten -->
        <Border x:Name="TourdatenKarte" Style="{StaticResource KarteStyle}">
            <StackPanel Spacing="18">
                <TextBlock Text="Tourdaten" Style="{StaticResource UeberschriftText}" />
                <Grid ColumnSpacing="18" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Tournummer *" Style="{StaticResource FeldLabel}" />
                        <TextBox x:Name="TournummerBox" Style="{StaticResource FormTextBox}" MaxLength="30"
                                 PlaceholderText="z. B. T-2401" AutomationProperties.Name="Tournummer" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Bereich / Abteilung *" Style="{StaticResource FeldLabel}" />
                        <ComboBox x:Name="AbteilungBox" Style="{StaticResource FormComboBox}" PlaceholderText="Bitte wählen"
                                  AutomationProperties.Name="Bereich" />
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Datum *" Style="{StaticResource FeldLabel}" />
                        <CalendarDatePicker x:Name="DatumBox" Style="{StaticResource FormDatePicker}"
                                            DateFormat="{}{day.integer(2)}.{month.integer(2)}.{year.full}"
                                            FirstDayOfWeek="Monday" AutomationProperties.Name="Datum" />
                    </StackPanel>
                    <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Start (Uhrzeit) *" Style="{StaticResource FeldLabel}" />
                            <TextBox x:Name="StartBox" Style="{StaticResource FormTextBox}" MaxLength="5" Text="08:00"
                                     PlaceholderText="hh:mm" AutomationProperties.Name="Startzeit" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Ende (Uhrzeit) *" Style="{StaticResource FeldLabel}" />
                            <TextBox x:Name="EndeBox" Style="{StaticResource FormTextBox}" MaxLength="5" Text="17:00"
                                     PlaceholderText="hh:mm" AutomationProperties.Name="Endzeit" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Startort *" Style="{StaticResource FeldLabel}" />
                        <TextBox x:Name="StartortBox" Style="{StaticResource FormTextBox}" MaxLength="200"
                                 PlaceholderText="z. B. Depot Nürnberg" AutomationProperties.Name="Startort" />
                        <!-- Erscheint, solange die Adresse der Spedition automatisch eingetragen ist. -->
                        <TextBlock x:Name="StartortHinweis" Style="{StaticResource HinweisText}" FontSize="13" Margin="0,4,0,0"
                                   TextWrapping="Wrap" Visibility="Collapsed"
                                   Text="Adresse Ihrer Spedition eingetragen – bei Bedarf einfach ändern." />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1">
                        <TextBlock Text="Zielort *" Style="{StaticResource FeldLabel}" />
                        <TextBox x:Name="ZielortBox" Style="{StaticResource FormTextBox}" MaxLength="200"
                                 PlaceholderText="z. B. Depot Nürnberg" AutomationProperties.Name="Zielort" />
                        <TextBlock x:Name="ZielortHinweis" Style="{StaticResource HinweisText}" FontSize="13" Margin="0,4,0,0"
                                   TextWrapping="Wrap" Visibility="Collapsed"
                                   Text="Adresse Ihrer Spedition eingetragen – bei Bedarf einfach ändern." />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Schritt 2: offene Sendungen -->
        <Border x:Name="SendungenKarte" Style="{StaticResource KarteStyle}">
            <StackPanel Spacing="12">
                <TextBlock Text="Sendungen übernehmen" Style="{StaticResource UeberschriftText}" />
                <TextBlock Style="{StaticResource HinweisText}"
                           Text="Für jede gewählte Sendung entstehen ein Abholstopp und ein Zustellstopp. Angezeigt werden Sendungen, die noch keiner Tour zugeordnet sind." />
                <ItemsControl x:Name="SendungListe">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:SendungZeile">
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                <CheckBox IsChecked="{x:Bind Ausgewaehlt}" Tag="{x:Bind Id}" Click="Sendung_Click">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Titel}" Style="{StaticResource NormalText}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Abholung}" Style="{StaticResource HinweisText}" />
                                        <TextBlock Text="{x:Bind Zustellung}" Style="{StaticResource HinweisText}" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="SendungLeerText" Style="{StaticResource HinweisText}" Visibility="Collapsed"
                           Text="Es gibt keine offenen Sendungen. Sie können trotzdem eigene Stopps hinzufügen." />
            </StackPanel>
        </Border>

        <!-- Schritt 2: eigener Stopp -->
        <Border x:Name="EigenerStoppKarte" Style="{StaticResource KarteStyle}">
            <StackPanel Spacing="14">
                <TextBlock Text="Eigenen Stopp hinzufügen" Style="{StaticResource UeberschriftText}" />
                <TextBlock Style="{StaticResource HinweisText}"
                           Text="Zum Beispiel Depot, Leergut oder ein Termin ohne Sendung. Das Zeitfenster gilt für das Datum der Tour." />
                <Grid ColumnSpacing="18" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Art *" Style="{StaticResource FeldLabel}" />
                        <ComboBox x:Name="StoppArtBox" Style="{StaticResource FormComboBox}" AutomationProperties.Name="Art des Stopps" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Bezeichnung *" Style="{StaticResource FeldLabel}" />
                        <TextBox x:Name="StoppBezeichnungBox" Style="{StaticResource FormTextBox}" MaxLength="200"
                                 PlaceholderText="z. B. Depot Hafen" AutomationProperties.Name="Bezeichnung des Stopps" />
                    </StackPanel>
                    <Grid Grid.Column="2" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Von *" Style="{StaticResource FeldLabel}" />
                            <TextBox x:Name="StoppVonBox" Style="{StaticResource FormTextBox}" MaxLength="5"
                                     PlaceholderText="hh:mm" AutomationProperties.Name="Zeitfenster von" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Bis *" Style="{StaticResource FeldLabel}" />
                            <TextBox x:Name="StoppBisBox" Style="{StaticResource FormTextBox}" MaxLength="5"
                                     PlaceholderText="hh:mm" AutomationProperties.Name="Zeitfenster bis" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                        <TextBlock Text="Adresse *" Style="{StaticResource FeldLabel}" />
                        <TextBox x:Name="StoppAdresseBox" Style="{StaticResource FormTextBox}" MaxLength="300"
                                 PlaceholderText="Straße Nr., PLZ Ort" AutomationProperties.Name="Adresse des Stopps" />
                    </StackPanel>
                    <Button Grid.Row="1" Grid.Column="2" Content="+ Stopp hinzufügen" Style="{StaticResource DashboardButton}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Click="StoppHinzufuegen_Click" />
                </Grid>
                <TextBlock x:Name="StoppFehlerText" Style="{StaticResource FehlerText}" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- Schritt 2: Stopps in Reihenfolge -->
        <Border x:Name="ReihenfolgeKarte" Style="{StaticResource KarteStyle}">
            <StackPanel Spacing="12">
                <TextBlock Text="Stopps in Reihenfolge" Style="{StaticResource UeberschriftText}" />
                <ItemsControl x:Name="StoppListe">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:StoppZeile">
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="15" VerticalAlignment="Center"
                                            Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{x:Bind Nummer}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    </Border>
                                    <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="4" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Art}" FontSize="13" Foreground="{StaticResource TextBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Bezeichnung}" Style="{StaticResource NormalText}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Adresse}" Style="{StaticResource HinweisText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Zeitfenster}" Style="{StaticResource NormalText}" />
                                        <TextBlock Text="{x:Bind Herkunft}" Style="{StaticResource HinweisText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button Content="↑" Tag="{x:Bind Index}" IsEnabled="{x:Bind KannHoch}" Click="StoppHoch_Click"
                                                Style="{StaticResource DashboardButton}" MinHeight="36" Padding="12,4"
                                                AutomationProperties.Name="Stopp nach oben" />
                                        <Button Content="↓" Tag="{x:Bind Index}" IsEnabled="{x:Bind KannRunter}" Click="StoppRunter_Click"
                                                Style="{StaticResource DashboardButton}" MinHeight="36" Padding="12,4"
                                                AutomationProperties.Name="Stopp nach unten" />
                                        <Button Content="✕" Tag="{x:Bind Index}" Visibility="{x:Bind EntfernenSichtbar}" Click="StoppEntfernen_Click"
                                                Style="{StaticResource DashboardButton}" MinHeight="36" Padding="12,4"
                                                ToolTipService.ToolTip="Eigenen Stopp entfernen" AutomationProperties.Name="Stopp entfernen" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="StoppLeerText" Style="{StaticResource HinweisText}"
                           Text="Noch keine Stopps. Wählen Sie oben Sendungen aus oder fügen Sie einen eigenen Stopp hinzu." />
            </StackPanel>
        </Border>

        <!-- Schritt 3: Fahrer und Fahrzeug (optional) -->
        <Border x:Name="FahrerKarte" Style="{StaticResource KarteStyle}">
            <StackPanel Spacing="14">
                <TextBlock Text="Fahrer &amp; Fahrzeug (optional)" Style="{StaticResource UeberschriftText}" />
                <TextBlock Style="{StaticResource HinweisText}"
                           Text="Ohne Auswahl wird die Tour als „Geplant“ gespeichert und kann später unter „Zuweisen“ zugeordnet werden. Mit beidem ist sie „Zugewiesen“." />
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Fahrer" Style="{StaticResource FeldLabel}" />
                        <ComboBox x:Name="FahrerBox" Style="{StaticResource FormComboBox}"
                                  AutomationProperties.Name="Fahrer" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Fahrzeug" Style="{StaticResource FeldLabel}" />
                        <ComboBox x:Name="FahrzeugBox" Style="{StaticResource FormComboBox}"
                                  AutomationProperties.Name="Fahrzeug" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Schritt 4: alles auf einen Blick, je Bereich mit „Ändern“. Wird im Code gefüllt. -->
        <Border x:Name="ZusammenfassungKarte" Style="{StaticResource KarteStyle}" Visibility="Collapsed">
            <StackPanel Spacing="14">
                <TextBlock Text="Zusammenfassung" Style="{StaticResource UeberschriftText}" />
                <StackPanel x:Name="ZusammenfassungListe" Spacing="12" />
            </StackPanel>
        </Border>

        <!-- Knöpfe -->
        <TextBlock x:Name="FehlerText" Style="{StaticResource FehlerText}" Visibility="Collapsed" />
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="Abbrechen" Style="{StaticResource DashboardButton}" Click="Abbrechen_Click" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                <Button x:Name="ZurueckButton" Content="← Zurück" Style="{StaticResource DashboardButton}"
                        Visibility="Collapsed" Click="Zurueck_Click" />
                <Button x:Name="WeiterButton" Content="Weiter →" Style="{StaticResource PrimaryButton}" Click="Weiter_Click" />
                <Button x:Name="SpeichernButton" Content="Tour speichern" Style="{StaticResource PrimaryButton}"
                        IsEnabled="False" Visibility="Collapsed" Click="Speichern_Click" />
            </StackPanel>
        </Grid>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
