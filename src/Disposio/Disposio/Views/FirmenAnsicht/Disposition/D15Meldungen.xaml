<?xml version="1.0" encoding="utf-8"?>
<!-- D15 „Meldungen bearbeiten“: Tank- und Schadensmeldungen der Fahrer-App sichten (Eingang), fachlich prüfen
     (Status, Zuständig, Betrag/Menge, Notiz) und den Fahrzeugstatus nach der Prüfung setzen. Foto bzw. Tankbeleg
     kommen aus public.dokument (Cloudinary). Startwert: optional die Id einer Schadensmeldung (aus D01). -->
<UserControl
    x:Class="Disposio.Views.D15Meldungen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Disposio.Views">

    <StackPanel Spacing="18">
        <!-- Filter. Datum lädt neu aus der Datenbank, Suche und Status filtern die geladene Liste. -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="220" />
                <ColumnDefinition Width="*" MinWidth="170" />
                <ColumnDefinition Width="1.3*" MinWidth="190" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Kennzeichen / Fahrer" Style="{StaticResource FeldLabel}" />
                <TextBox x:Name="SuchBox" Style="{StaticResource FormTextBox}" PlaceholderText="Begriff eingeben"
                         KeyDown="SuchBox_KeyDown" AutomationProperties.Name="Kennzeichen oder Fahrer suchen" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Status" Style="{StaticResource FeldLabel}" />
                <ComboBox x:Name="StatusFilter" Style="{StaticResource FormComboBox}" AutomationProperties.Name="Status" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Datum" Style="{StaticResource FeldLabel}" />
                <CalendarDatePicker x:Name="DatumAuswahl" Style="{StaticResource FormDatePicker}"
                                    DateFormat="{}{day.integer(2)}.{month.integer(2)}.{year.full}"
                                    FirstDayOfWeek="Monday" AutomationProperties.Name="Datum" />
            </StackPanel>
            <Button Grid.Column="3" Content="Filter anwenden" Style="{StaticResource DashboardButton}"
                    VerticalAlignment="Bottom" Click="FilterAnwenden_Click" />
        </Grid>

        <!-- Eingang -->
        <Border Style="{StaticResource KarteStyle}">
            <StackPanel Spacing="12">
                <Grid>
                    <TextBlock Text="Eingang" Style="{StaticResource UeberschriftText}" />
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ProgressRing x:Name="LadeAnzeige" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource HinweisText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="14,10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="0.9*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Meldung" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Fahrzeug / Fahrer" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Zeitpunkt" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Status" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                    </Grid>
                </Border>

                <!-- Klick auf eine Zeile öffnet die Meldung unten zur Prüfung. Hover und Markierung: ListenZeile.cs -->
                <ItemsControl x:Name="MeldungListe">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:MeldungZeile">
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Border local:ListenZeile.Aktiv="True" local:ListenZeile.Markiert="{x:Bind IstMarkiert}"
                                    Tag="{x:Bind Schluessel}" Tapped="Zeile_Tapped"
                                    BorderThickness="4,0,0,0" CornerRadius="6" Padding="10,12,14,12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="0.9*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Titel}" Style="{StaticResource NormalText}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind FahrzeugUndFahrer}" Style="{StaticResource NormalText}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Zeitpunkt}" Style="{StaticResource NormalText}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Border CornerRadius="11" Padding="10,2" BorderThickness="1" HorizontalAlignment="Left"
                                                BorderBrush="{x:Bind StatusRand}">
                                            <TextBlock Text="{x:Bind Status}" FontSize="13" Foreground="{x:Bind StatusSchrift}" />
                                        </Border>
                                        <TextBlock Text="{x:Bind Zusatz}" Style="{StaticResource FehlerText}" FontSize="12"
                                                   Visibility="{x:Bind ZusatzSichtbar}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="LeerText" Visibility="Collapsed" Style="{StaticResource HinweisText}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel x:Name="Formular" Spacing="12" Visibility="Collapsed">
            <TextBlock Text="* Pflichtfeld" Style="{StaticResource HinweisText}" FontSize="13" />

            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Meldung prüfen -->
                <Border Style="{StaticResource KarteStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Meldung prüfen" Style="{StaticResource UeberschriftText}" />
                        <Grid ColumnSpacing="18" RowSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Vorgang *" Style="{StaticResource FeldLabel}" />
                                <ComboBox x:Name="VorgangBox" Style="{StaticResource FormComboBox}"
                                          SelectionChanged="VorgangBox_SelectionChanged" AutomationProperties.Name="Vorgang" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Bearbeitungsstatus *" Style="{StaticResource FeldLabel}" />
                                <ComboBox x:Name="StatusBox" Style="{StaticResource FormComboBox}" PlaceholderText="Bitte wählen"
                                          AutomationProperties.Name="Bearbeitungsstatus" />
                            </StackPanel>
                            <StackPanel Grid.Row="1">
                                <TextBlock Text="Zuständig *" Style="{StaticResource FeldLabel}" />
                                <ComboBox x:Name="ZustaendigBox" Style="{StaticResource FormComboBox}" PlaceholderText="Bitte wählen"
                                          AutomationProperties.Name="Zuständig" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock x:Name="BetragLabel" Text="Betrag / Menge laut Beleg *" Style="{StaticResource FeldLabel}" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="MengeSpalte" Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BetragBox" Style="{StaticResource FormTextBox}" MaxLength="12"
                                             PlaceholderText="EUR" AutomationProperties.Name="Betrag in Euro" />
                                    <TextBox x:Name="MengeBox" Grid.Column="1" Style="{StaticResource FormTextBox}" MaxLength="8"
                                             PlaceholderText="Liter" AutomationProperties.Name="Menge in Litern" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                                <TextBlock Text="Rückfrage / Bearbeitungsnotiz *" Style="{StaticResource FeldLabel}" />
                                <TextBox x:Name="NotizBox" Style="{StaticResource FormTextBox}" AcceptsReturn="True"
                                         TextWrapping="Wrap" Height="110" MaxLength="2000"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         PlaceholderText="z. B. Bitte weiteres Foto der Türdichtung ergänzen."
                                         AutomationProperties.Name="Rückfrage oder Bearbeitungsnotiz" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Anhang & Fahrzeugstatus -->
                <Border Grid.Column="1" Style="{StaticResource KarteStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Anhang &amp; Fahrzeugstatus" Style="{StaticResource UeberschriftText}" />
                        <Grid MinHeight="180">
                            <Rectangle Stroke="{StaticResource BorderBrush}" StrokeThickness="1.5" StrokeDashArray="4,3"
                                       RadiusX="6" RadiusY="6" />
                            <Image x:Name="AnhangBild" Margin="10" MaxHeight="320" Stretch="Uniform" Visibility="Collapsed"
                                   ImageFailed="AnhangBild_ImageFailed" AutomationProperties.Name="Foto oder Tankbeleg" />
                            <ProgressRing x:Name="BildLadeAnzeige" Width="24" Height="24" IsActive="False" Visibility="Collapsed" />
                            <TextBlock x:Name="AnhangText" Style="{StaticResource HinweisText}" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <HyperlinkButton x:Name="OriginalKnopf" Content="Original öffnen" Padding="0,2" Visibility="Collapsed"
                                         Click="OriginalOeffnen_Click" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource NormalText}">
                            <Run Text="Fahrerhinweis: " FontWeight="SemiBold" /><Run x:Name="FahrerhinweisText" />
                        </TextBlock>
                        <StackPanel>
                            <TextBlock Text="Verfügbarkeit nach Prüfung *" Style="{StaticResource FeldLabel}" />
                            <ComboBox x:Name="VerfuegbarkeitBox" Style="{StaticResource FormComboBox}" PlaceholderText="Bitte wählen"
                                      AutomationProperties.Name="Verfügbarkeit des Fahrzeugs nach der Prüfung" />
                            <TextBlock x:Name="FahrzeugHinweis" Style="{StaticResource HinweisText}" FontSize="13" Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="FehlerText" Style="{StaticResource FehlerText}" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                <Button Content="Abbrechen" Style="{StaticResource DashboardButton}" Click="Abbrechen_Click"
                        ToolTipService.ToolTip="Änderungen verwerfen und die gespeicherten Werte wieder anzeigen" />
                <Button x:Name="SpeichernButton" Content="Bearbeitung speichern" Style="{StaticResource PrimaryButton}"
                        Click="Speichern_Click" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
