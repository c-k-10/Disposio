<?xml version="1.0" encoding="utf-8"?>
<!-- D11 „Frachtdokumente & Abliefernachweise“: Dokumente je Sendung (aus der Fahrer-App und hier zugeordnet),
     Abliefernachweise mit Problemmeldungen, Vorschau rechts. Unten „Dokument ergänzen“ (Upload zu Cloudinary).
     Startwert: optional eine Tour-Id (aus D07 „Frachtdokumente“), dann werden deren Sendungen gezeigt. -->
<UserControl
    x:Class="Disposio.Views.D11Frachtdokumente"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Disposio.Views">

    <StackPanel Spacing="18">
        <!-- Filter wie im Wireframe. Mit Suchbegriff wird über alle Tage gesucht. -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" MinWidth="200" />
                <ColumnDefinition Width="*" MinWidth="170" />
                <ColumnDefinition Width="1.2*" MinWidth="190" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Referenz / Dokument" Style="{StaticResource FeldLabel}" />
                <TextBox x:Name="SuchBox" Style="{StaticResource FormTextBox}" PlaceholderText="Begriff eingeben"
                         KeyDown="SuchBox_KeyDown" AutomationProperties.Name="Referenz oder Dokument suchen" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Status" Style="{StaticResource FeldLabel}" />
                <ComboBox x:Name="StatusAuswahl" Style="{StaticResource FormComboBox}" HorizontalAlignment="Stretch"
                          SelectionChanged="StatusAuswahl_SelectionChanged" AutomationProperties.Name="Status" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Datum" Style="{StaticResource FeldLabel}" />
                <CalendarDatePicker x:Name="DatumAuswahl" Style="{StaticResource FormDatePicker}"
                                    DateFormat="{}{day.integer(2)}.{month.integer(2)}.{year.full}"
                                    FirstDayOfWeek="Monday" AutomationProperties.Name="Datum" />
            </StackPanel>
            <Button Grid.Column="3" Content="Filter anwenden" Style="{StaticResource DashboardButton}"
                    VerticalAlignment="Bottom" Click="FilterAnwenden_Click" />
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <ProgressRing x:Name="LadeAnzeige" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Style="{StaticResource HinweisText}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Treffer: mehrere Sendungen zum Filter. Klick wählt eine aus. -->
        <ListView x:Name="SendungListe" SelectionMode="Single" MaxHeight="230" Visibility="Collapsed"
                  SelectionChanged="SendungListe_SelectionChanged" AutomationProperties.Name="Sendungen">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="12,8" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SendungTrefferZeile">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Referenz}" Style="{StaticResource NormalText}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{x:Bind KundeUndDatum}" Style="{StaticResource NormalText}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind DokumenteText}" Style="{StaticResource HinweisText}" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Status}" Style="{StaticResource NormalText}"
                                   Foreground="{x:Bind StatusFarbe}" FontWeight="SemiBold" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="LeerText" Visibility="Collapsed" Style="{StaticResource HinweisText}" />

        <!-- Dokumente links, Vorschau rechts -->
        <Grid x:Name="DokumentBereich" ColumnSpacing="20" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource KarteStyle}" VerticalAlignment="Top">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="DokumenteTitel" Text="Dokumente" Style="{StaticResource UeberschriftText}" Margin="0,0,0,8" />
                    <ItemsControl x:Name="EintragListe">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:DokumentEintragZeile">
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{x:Bind Titel}" Style="{StaticResource NormalText}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Untertitel}" Style="{StaticResource HinweisText}" />
                                            <TextBlock Text="{x:Bind Problem}" Style="{StaticResource FehlerText}"
                                                       Visibility="{x:Bind ProblemSichtbar}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Vorschau" Tag="{x:Bind Selbst}"
                                                Style="{StaticResource DashboardButton}" MinHeight="36" Padding="14,4"
                                                VerticalAlignment="Center" Click="Vorschau_Click"
                                                AutomationProperties.Name="{x:Bind VorschauBeschreibung}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="KeineDokumente" Visibility="Collapsed" Style="{StaticResource HinweisText}"
                               Text="Zu dieser Sendung gibt es noch keine Dokumente und keinen Abliefernachweis." />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource KarteStyle}" VerticalAlignment="Top">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="VorschauTitel" Text="Vorschau" Style="{StaticResource UeberschriftText}" />
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                            Background="{StaticResource InputBrush}" MinHeight="180" Padding="16">
                        <Grid>
                            <Image x:Name="VorschauBild" MaxHeight="460" Stretch="Uniform" Visibility="Collapsed"
                                   ImageFailed="VorschauBild_ImageFailed" AutomationProperties.Name="Dokumentvorschau" />
                            <ProgressRing x:Name="BildLadeAnzeige" Width="24" Height="24" IsActive="False" Visibility="Collapsed" />
                            <TextBlock x:Name="VorschauText" Style="{StaticResource HinweisText}" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsTextSelectionEnabled="True" />
                        </Grid>
                    </Border>
                    <Button x:Name="OriginalKnopf" Content="Original öffnen" Style="{StaticResource DashboardButton}"
                            HorizontalAlignment="Left" Visibility="Collapsed" Click="OriginalOeffnen_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Dokument ergänzen -->
        <TextBlock Text="* Pflichtfeld" Style="{StaticResource HinweisText}" FontSize="13" />
        <Border Style="{StaticResource KarteStyle}">
            <StackPanel Spacing="14">
                <TextBlock Text="Dokument ergänzen" Style="{StaticResource UeberschriftText}" />
                <TextBlock x:Name="SpeicherHinweis" Style="{StaticResource FehlerText}" Visibility="Collapsed"
                           Text="Hochladen ist auf diesem Rechner noch nicht eingerichtet: Windows-Benutzervariable DISPOSIO_CLOUDINARY_URL fehlt (Wert von Nils, wie Cloudinary__Url der Fahrer-API)." />
                <Grid ColumnSpacing="20" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Sendungsreferenz *" Style="{StaticResource FeldLabel}" />
                        <TextBox x:Name="ReferenzBox" Style="{StaticResource FormTextBox}" MaxLength="100"
                                 PlaceholderText="Kundenreferenz oder Auftragsnummer" AutomationProperties.Name="Sendungsreferenz" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Dokumentart *" Style="{StaticResource FeldLabel}" />
                        <ComboBox x:Name="ArtAuswahl" Style="{StaticResource FormComboBox}" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="Dokumentart" />
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Datei *" Style="{StaticResource FeldLabel}" />
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                Background="{StaticResource InputBrush}" Padding="8,6">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button x:Name="DateiKnopf" Content="Datei auswählen" Style="{StaticResource DashboardButton}"
                                        MinHeight="34" Padding="12,2" Click="DateiAuswaehlen_Click" />
                                <TextBlock x:Name="DateiText" Text="Keine Datei ausgewählt" Style="{StaticResource HinweisText}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="PDF, JPG oder PNG, höchstens 10 MB." Style="{StaticResource HinweisText}"
                                   FontSize="13" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <TextBlock Text="Bemerkung" Style="{StaticResource FeldLabel}" />
                        <TextBox x:Name="BemerkungBox" Style="{StaticResource FormTextBox}" MaxLength="500"
                                 AutomationProperties.Name="Bemerkung" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ZuordnenText" Style="{StaticResource HinweisText}" VerticalAlignment="Center" />
            <Button x:Name="ZuordnenKnopf" Grid.Column="1" Content="Dokument zuordnen" Style="{StaticResource PrimaryButton}"
                    Click="Zuordnen_Click" />
        </Grid>
    </StackPanel>
</UserControl>
