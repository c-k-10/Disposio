<?xml version="1.0" encoding="utf-8"?>
<!-- D01 „Tagesübersicht“: Schichtbeginn des Disponenten. Oben vier Kennzahlen, darunter was seit der letzten
     Abmeldung passiert ist und was heute zuerst erledigt werden sollte. Jeder Knopf öffnet die passende Ansicht.
     Titel und Untertitel setzt der Rahmen (FirmenAnsicht) aus dem AnsichtenKatalog. -->
<UserControl
    x:Class="Disposio.Views.D01Tagesuebersicht"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Disposio.Views">

    <StackPanel Spacing="18">
        <!-- Status links, „Aktualisieren“ rechts (wie G02). -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ProgressRing x:Name="LadeAnzeige" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" Style="{StaticResource HinweisText}" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Content="Aktualisieren" Style="{StaticResource DashboardButton}" Click="Aktualisieren_Click" />
        </Grid>

        <!-- Kennzahlen: vier gleich breite Kacheln. -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource KarteStyle}" Padding="22,18">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="TourenWert" Text="–" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="Touren heute" Style="{StaticResource HinweisText}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource KarteStyle}" Padding="22,18">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="UnverplantWert" Text="–" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="Sendungen unverplant" Style="{StaticResource HinweisText}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource KarteStyle}" Padding="22,18">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="FreigabenWert" Text="–" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="Freigaben offen" Style="{StaticResource HinweisText}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource KarteStyle}" Padding="22,18">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="SchaedenWert" Text="–" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock x:Name="SchaedenText" Text="Schadensmeldungen offen" Style="{StaticResource HinweisText}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Seit Ihrer letzten Schicht -->
        <Border Style="{StaticResource KarteStyle}">
            <StackPanel Spacing="10">
                <StackPanel Spacing="2">
                    <TextBlock Text="Seit Ihrer letzten Schicht" Style="{StaticResource UeberschriftText}" />
                    <TextBlock x:Name="ZeitraumText" Style="{StaticResource HinweisText}" />
                </StackPanel>

                <ItemsControl x:Name="EreignisListe">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:EreignisZeile">
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,14">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Kopf}" Style="{StaticResource NormalText}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource HinweisText}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{x:Bind KnopfText}" Tag="{x:Bind Selbst}"
                                            Style="{StaticResource DashboardButton}" MinHeight="36" Padding="14,4"
                                            VerticalAlignment="Center" Click="Ereignis_Click"
                                            AutomationProperties.Name="{x:Bind KnopfBeschreibung}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="EreignisLeer" Visibility="Collapsed" Style="{StaticResource HinweisText}"
                           Text="Seitdem ist nichts Besonderes passiert." />
            </StackPanel>
        </Border>

        <!-- Heute priorisieren: Tabelle Hinweis / Auswirkung / Nächster Schritt -->
        <Border Style="{StaticResource KarteStyle}">
            <StackPanel Spacing="12">
                <TextBlock Text="Heute priorisieren" Style="{StaticResource UeberschriftText}" />

                <Border Background="{StaticResource InputBrush}" CornerRadius="4" Padding="14,10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="190" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Hinweis" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Auswirkung" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Nächster Schritt" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                    </Grid>
                </Border>

                <ItemsControl x:Name="HinweisListe">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:HinweisZeile">
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="190" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Hinweis}" Style="{StaticResource NormalText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Auswirkung}" Style="{StaticResource NormalText}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="{x:Bind KnopfText}" Tag="{x:Bind Selbst}"
                                            Style="{StaticResource DashboardButton}" MinHeight="36" Padding="14,4"
                                            VerticalAlignment="Center" Click="Hinweis_Click"
                                            AutomationProperties.Name="{x:Bind KnopfBeschreibung}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="HinweisLeer" Visibility="Collapsed" Style="{StaticResource HinweisText}"
                           Text="Heute steht nichts Dringendes an." />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
