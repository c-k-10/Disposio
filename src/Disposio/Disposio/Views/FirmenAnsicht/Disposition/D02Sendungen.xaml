<?xml version="1.0" encoding="utf-8"?>
<!-- D02 „Sendungen“: Aufträge eines Tages suchen und zur Planung auswählen. „+ Sendung erfassen“ und „Details“
     öffnen D03, „Planungsvorschlag prüfen“ öffnet D13 und „Manuell verplanen“ die Tourplanung D05,
     jeweils mit den angehakten Sendungen.
     Aufbau: oben „Noch zu verplanen“ als Karten (Häkchen, Felder für Fahrer/Fahrzeug zum Draufziehen), darunter
     „Verplant“ nach Tour gruppiert. Der Status ist farbig hervorgehoben (StatusFarbe in D02Sendungen.xaml.cs).
     Der Pfeil neben „⋯“ klappt eine Sendung auf: alle Angaben und ein Kartenausschnitt mit der Strecke.
     Gezogene Fahrer/Fahrzeuge werden nur vorgemerkt; „Zuweisungen speichern“ legt alle vollständigen auf einmal an. Rechts „Verfügbar am …“: einsetzbare Fahrer und Fahrzeuge des Tages.
     Zieht man einen davon auf eine unverplante Sendung, erscheint er in der Spalte „Fahrer / Fahrzeug“. Sind beide
     gesetzt, wird sofort eine Tour angelegt (wie in D16), ohne die Ansicht zu verlassen. Bei verplanten Sendungen
     (Tour noch nicht losgefahren) lassen sich Fahrer/Fahrzeug mit ✕ entfernen oder per Ziehen tauschen,
     „Lösen“ nimmt die Sendung wieder aus der Tour. -->
<UserControl
    x:Class="Disposio.Views.D02Sendungen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Disposio.Views">

    <StackPanel x:Name="Seite" Spacing="18">
        <!-- Leiste mit Anzahl unverplanter Sendungen und „+ Sendung erfassen“ -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="5" Background="{StaticResource AccentBrush}" CornerRadius="4,0,0,4" />
                <TextBlock x:Name="UnverplantText" Grid.Column="1" Style="{StaticResource NormalText}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="22,0" Text="Sendungen werden geladen …" />
                <Button Grid.Column="2" Content="+ Sendung erfassen" Style="{StaticResource PrimaryButton}"
                        Margin="0,14,18,14" Click="SendungErfassen_Click" />
            </Grid>
        </Border>

        <!-- Filter. Datum lädt neu aus der Datenbank, Suche und Status filtern die geladene Liste. -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="220" />
                <ColumnDefinition Width="*" MinWidth="170" />
                <ColumnDefinition Width="1.3*" MinWidth="190" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Kundenreferenz / Ort" Style="{StaticResource FeldLabel}" />
                <TextBox x:Name="SuchBox" Style="{StaticResource FormTextBox}" PlaceholderText="Begriff eingeben"
                         KeyDown="SuchBox_KeyDown" AutomationProperties.Name="Kundenreferenz oder Ort suchen" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Status" Style="{StaticResource FeldLabel}" />
                <ComboBox x:Name="StatusAuswahl" Style="{StaticResource FormComboBox}" AutomationProperties.Name="Status" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Datum" Style="{StaticResource FeldLabel}" />
                <CalendarDatePicker x:Name="DatumAuswahl" Style="{StaticResource FormDatePicker}"
                                    DateFormat="{}{day.integer(2)}.{month.integer(2)}.{year.full}"
                                    FirstDayOfWeek="Monday" AutomationProperties.Name="Datum" />
            </StackPanel>
            <Button Grid.Column="3" Content="Filter anwenden" Style="{StaticResource DashboardButton}"
                    VerticalAlignment="Bottom" Click="FilterAnwenden_Click" />
        </Grid>

        <!-- Links die Sendungen, rechts die verfügbaren Fahrer und Fahrzeuge zum Draufziehen -->
        <Grid x:Name="InhaltRaster" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

        <StackPanel Spacing="18" VerticalAlignment="Top">
        <!-- Noch zu verplanen: zweizeilige Karten -->
        <Border Style="{StaticResource KarteStyle}">
            <StackPanel Spacing="14">
                <Grid>
                    <TextBlock x:Name="OffenTitel" Text="Noch zu verplanen" Style="{StaticResource UeberschriftText}" />
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ProgressRing x:Name="LadeAnzeige" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource HinweisText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Vorgemerkte Zuweisungen: erst mit „Zuweisungen speichern“ werden daraus Touren. -->
                <Border x:Name="VormerkungLeiste" Visibility="Collapsed" Background="{StaticResource InputBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7C3;" FontSize="18" VerticalAlignment="Center"
                                  Foreground="{StaticResource AccentBrush}" />
                        <TextBlock x:Name="VormerkungText" Grid.Column="1" Style="{StaticResource NormalText}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button x:Name="VerwerfenButton" Grid.Column="2" Content="Verwerfen" Style="{StaticResource DashboardButton}"
                                Click="Verwerfen_Click" ToolTipService.ToolTip="Alle vorgemerkten Fahrer und Fahrzeuge wieder entfernen" />
                        <Button x:Name="SpeichernButton" Grid.Column="3" Content="Zuweisungen speichern" Style="{StaticResource PrimaryButton}"
                                Click="ZuweisungenSpeichern_Click" />
                    </Grid>
                </Border>

                <ItemsControl x:Name="OffenListe">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="14" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:SendungKarte">
                            <!-- Ganze Karte ist Ablagefläche für Fahrer/Fahrzeug. Hover und Auswahlbalken: ListenZeile.cs -->
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="2" CornerRadius="8">
                            <Border local:ListenZeile.Aktiv="True" local:ListenZeile.Markiert="{x:Bind IstMarkiert}"
                                    Tag="{x:Bind Id}" AllowDrop="True" DragOver="Zeile_DragOver" DragLeave="Zeile_DragLeave"
                                    Drop="Zeile_Drop" BorderThickness="4,0,0,0" CornerRadius="6" Padding="12,12,14,12">
                                <StackPanel>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{x:Bind Ausgewaehlt}" Tag="{x:Bind Id}" Click="Auswahl_Click" MinWidth="0"
                                              VerticalAlignment="Center" AutomationProperties.Name="Zur Planung auswählen" />
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{x:Bind Titel}" Style="{StaticResource NormalText}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <Border CornerRadius="11" Padding="10,2" BorderThickness="1" VerticalAlignment="Center"
                                    Background="{x:Bind StatusHintergrund}" BorderBrush="{x:Bind StatusRand}">
                                <TextBlock Text="{x:Bind Status}" FontSize="13" FontWeight="SemiBold" Foreground="{x:Bind StatusSchrift}" />
                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Zeile1}" Style="{StaticResource HinweisText}" TextWrapping="WrapWholeWords" />
                                        <TextBlock Text="{x:Bind Zeile2}" Style="{StaticResource HinweisText}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                    <Border Grid.Column="2">
                                            <!-- Felder für Fahrer und Fahrzeug: feste Breite, gestrichelt solange leer. -->
                                            <StackPanel Spacing="6" Width="200" VerticalAlignment="Center">
                                                <Grid Height="38">
                                                    <Rectangle RadiusX="6" RadiusY="6" StrokeThickness="1.2" Stroke="{x:Bind FahrerRand}"
                                                               StrokeDashArray="{x:Bind FahrerStrich}" Fill="{x:Bind FahrerFuellung}" />
                                                    <Grid Margin="10,0,4,0" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="&#xE77B;" FontSize="14" VerticalAlignment="Center" Foreground="{x:Bind FahrerFarbe}" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind FahrerText}" FontSize="14" VerticalAlignment="Center"
                                                                   Foreground="{x:Bind FahrerFarbe}" TextTrimming="CharacterEllipsis" />
                                                        <Button Grid.Column="2" Content="✕" Tag="{x:Bind Schluessel}" Visibility="{x:Bind FahrerEntfernenSichtbar}"
                                                                Click="FahrerEntfernen_Click" Background="Transparent" BorderThickness="0" FontSize="11"
                                                                MinHeight="0" MinWidth="0" Padding="7,3"
                                                                ToolTipService.ToolTip="Fahrer wieder entfernen" AutomationProperties.Name="Fahrer entfernen" />
                                                    </Grid>
                                                </Grid>
                                                <Grid Height="38">
                                                    <Rectangle RadiusX="6" RadiusY="6" StrokeThickness="1.2" Stroke="{x:Bind FahrzeugRand}"
                                                               StrokeDashArray="{x:Bind FahrzeugStrich}" Fill="{x:Bind FahrzeugFuellung}" />
                                                    <Grid Margin="10,0,4,0" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="&#xE806;" FontSize="14" VerticalAlignment="Center" Foreground="{x:Bind FahrzeugFarbe}" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind FahrzeugText}" FontSize="14" VerticalAlignment="Center"
                                                                   Foreground="{x:Bind FahrzeugFarbe}" TextTrimming="CharacterEllipsis" />
                                                        <Button Grid.Column="2" Content="✕" Tag="{x:Bind Schluessel}" Visibility="{x:Bind FahrzeugEntfernenSichtbar}"
                                                                Click="FahrzeugEntfernen_Click" Background="Transparent" BorderThickness="0" FontSize="11"
                                                                MinHeight="0" MinWidth="0" Padding="7,3"
                                                                ToolTipService.ToolTip="Fahrzeug wieder entfernen" AutomationProperties.Name="Fahrzeug entfernen" />
                                                    </Grid>
                                                </Grid>
                                                <TextBlock Text="{x:Bind Hinweis}" FontSize="13" TextWrapping="Wrap"
                                                           Foreground="{x:Bind HinweisFarbe}" Visibility="{x:Bind HinweisSichtbar}" />
                                            </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                                    <Button Tag="{x:Bind Id}" Click="Aufklappen_Click" Style="{StaticResource DashboardButton}" Padding="10,6" MinHeight="0"
                                            VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Details.PfeilTipp}"
                                            AutomationProperties.Name="{x:Bind Details.PfeilTipp}">
                                        <FontIcon Glyph="{x:Bind Details.PfeilGlyph}" FontSize="14" />
                                    </Button>
                                    <Button Style="{StaticResource DashboardButton}" Padding="10,6" MinHeight="0" VerticalAlignment="Center"
                                                        ToolTipService.ToolTip="Weitere Aktionen" AutomationProperties.Name="Weitere Aktionen">
                                                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                                                    <Button.Flyout>
                                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                            <MenuFlyoutItem Text="Details" Tag="{x:Bind Id}" Click="Details_Click">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="In großer Ansicht zuweisen" Tag="{x:Bind Id}" Click="Zuweisen_Click">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77B;" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                    </StackPanel>
                                </Grid>
                                <!-- Aufgeklappt: links eine kompakte Liste mit Trennlinien (Strecke A → B, Ladung, Vor Ort, Auftrag),
                                     rechts ein Kartenausschnitt mit der Strecke. -->
                                <Grid Visibility="{x:Bind Details.Sichtbar}" Margin="0,12,0,2" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Details.LadeText}" Style="{StaticResource HinweisText}"
                                               Visibility="{x:Bind Details.LadeSichtbar}" />
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,0"
                                            Visibility="{x:Bind Details.InhaltSichtbar}">
                                        <StackPanel>
                                            <!-- Strecke: A und B mit Verbindungslinie, Zeitfenster rechtsbündig -->
                                            <Grid ColumnSpacing="10" RowSpacing="6" Padding="0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Rectangle Grid.RowSpan="2" Width="2" Margin="0,12,0,12" HorizontalAlignment="Center"
                                                           Fill="{StaticResource BorderBrush}" />
                                                <Border Width="20" Height="20" CornerRadius="10" VerticalAlignment="Top" Margin="0,1,0,0"
                                                        Background="{x:Bind Details.AbholFarbe}">
                                                    <TextBlock Text="A" Foreground="White" FontWeight="Bold" FontSize="11"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Details.AbholAdresse}" Style="{StaticResource NormalText}"
                                                           FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Details.AbholZeit}" Style="{StaticResource HinweisText}"
                                                           FontSize="13" Margin="0,1,0,0" />
                                                <Border Grid.Row="1" Width="20" Height="20" CornerRadius="10" VerticalAlignment="Top" Margin="0,1,0,0"
                                                        Background="{x:Bind Details.ZustellFarbe}">
                                                    <TextBlock Text="B" Foreground="White" FontWeight="Bold" FontSize="11"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Details.ZustellAdresse}" Style="{StaticResource NormalText}"
                                                           FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Bind Details.ZustellZeit}" Style="{StaticResource HinweisText}"
                                                           FontSize="13" Margin="0,1,0,0" />
                                            </Grid>
                                            <Rectangle Height="1" Fill="{StaticResource BorderBrush}" />

                                            <!-- Ladung -->
                                            <Grid ColumnSpacing="10" Padding="0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Ladung" Style="{StaticResource HinweisText}" FontSize="13" FontWeight="SemiBold" />
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock Text="{x:Bind Details.LadungZeile1}" Style="{StaticResource NormalText}" FontSize="14"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind Details.LadungZeile2}" Style="{StaticResource HinweisText}" FontSize="13"
                                                               TextWrapping="Wrap" />
                                                    <ItemsRepeater ItemsSource="{x:Bind Details.Merkmale}" Visibility="{x:Bind Details.MerkmaleSichtbar}"
                                                                   Margin="0,2,0,0">
                                                        <ItemsRepeater.Layout>
                                                            <StackLayout Orientation="Horizontal" Spacing="6" />
                                                        </ItemsRepeater.Layout>
                                                        <ItemsRepeater.ItemTemplate>
                                                            <DataTemplate x:DataType="local:DetailMerkmal">
                                                                <Border Background="{x:Bind Hintergrund}" BorderBrush="{x:Bind Rand}" BorderThickness="1"
                                                                        CornerRadius="9" Padding="8,1">
                                                                    <TextBlock Text="{x:Bind Text}" Foreground="{x:Bind Schrift}" FontSize="12" FontWeight="SemiBold" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsRepeater.ItemTemplate>
                                                    </ItemsRepeater>
                                                </StackPanel>
                                            </Grid>
                                            <Rectangle Height="1" Fill="{StaticResource BorderBrush}" />

                                            <!-- Vor Ort -->
                                            <Grid ColumnSpacing="10" Padding="0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Vor Ort" Style="{StaticResource HinweisText}" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Details.VorOrt}" Style="{StaticResource NormalText}" FontSize="14"
                                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                <Border Grid.Column="2" Background="{x:Bind Details.Avisierung.Hintergrund}" BorderBrush="{x:Bind Details.Avisierung.Rand}"
                                                        BorderThickness="1" CornerRadius="9" Padding="8,1" VerticalAlignment="Top"
                                                        Visibility="{x:Bind Details.AvisierungSichtbar}">
                                                    <TextBlock Text="{x:Bind Details.Avisierung.Text}" Foreground="{x:Bind Details.Avisierung.Schrift}"
                                                               FontSize="12" FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                            <Rectangle Height="1" Fill="{StaticResource BorderBrush}" />

                                            <!-- Auftrag -->
                                            <Grid ColumnSpacing="10" Padding="0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Auftrag" Style="{StaticResource HinweisText}" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Details.Auftrag}" Style="{StaticResource NormalText}" FontSize="14"
                                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                <Border Grid.Column="2" Background="{x:Bind Details.Prioritaet.Hintergrund}" BorderBrush="{x:Bind Details.Prioritaet.Rand}"
                                                        BorderThickness="1" CornerRadius="9" Padding="8,1" VerticalAlignment="Top">
                                                    <TextBlock Text="{x:Bind Details.Prioritaet.Text}" Foreground="{x:Bind Details.Prioritaet.Schrift}"
                                                               FontSize="12" FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <!-- Kartenausschnitt: WebView2 wird erst beim Aufklappen erzeugt (Strecke_Loaded). So hoch wie die Liste links. -->
                                    <Border Grid.Column="1" MinHeight="200" CornerRadius="6" BorderThickness="1"
                                            BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource InputBrush}"
                                            Visibility="{x:Bind Details.InhaltSichtbar}" Tag="{x:Bind Id}"
                                            Loaded="Strecke_Loaded" Unloaded="Strecke_Unloaded" />
                                </Grid>
                                </StackPanel>
                            </Border>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="OffenLeerText" Visibility="Collapsed" Style="{StaticResource HinweisText}" TextWrapping="Wrap" />

                <!-- Planung der angehakten Sendungen -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="VorschlagButton" Content="Planungsvorschlag prüfen" Style="{StaticResource PrimaryButton}"
                                IsEnabled="False" Click="Planungsvorschlag_Click" />
                        <Button x:Name="ManuellButton" Content="Manuell verplanen" Style="{StaticResource DashboardButton}"
                                IsEnabled="False" Click="ManuellVerplanen_Click" />
                    </StackPanel>
                    <TextBlock x:Name="AuswahlText" Style="{StaticResource HinweisText}"
                               Text="Haken Sie Sendungen an, um sie zu einer Tour zusammenzustellen." />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Verplant: nach Tour gruppiert. Fahrer/Fahrzeug gehören zur Tour (Kopf der Gruppe). -->
        <Border Style="{StaticResource KarteStyle}">
            <StackPanel Spacing="14">
                <TextBlock x:Name="VerplantTitel" Text="Verplant" Style="{StaticResource UeberschriftText}" />
                <ItemsControl x:Name="TourListe">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="16" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:TourGruppe">
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="2" CornerRadius="8">
                                <StackPanel>
                                    <!-- Kopf: Tour, Status, Fahrer und Fahrzeug. Ablagefläche zum Tauschen (nur vor Fahrtbeginn). -->
                                    <Border Background="{StaticResource InputBrush}" CornerRadius="6,6,0,0" Padding="14,10"
                                            Tag="{x:Bind TourId}" AllowDrop="{x:Bind Bearbeitbar}"
                                            DragOver="Tour_DragOver" DragLeave="Tour_DragLeave" Drop="Tour_Drop">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <FontIcon Glyph="&#xE806;" FontSize="16" VerticalAlignment="Center"
                                                              Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Text="{x:Bind Titel}" Style="{StaticResource NormalText}" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <Border CornerRadius="11" Padding="10,2" BorderThickness="1" VerticalAlignment="Center"
                                    Background="{x:Bind StatusHintergrund}" BorderBrush="{x:Bind StatusRand}">
                                <TextBlock Text="{x:Bind Status}" FontSize="13" FontWeight="SemiBold" Foreground="{x:Bind StatusSchrift}" />
                            </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Zeile1}" Style="{StaticResource HinweisText}" FontSize="13" />
                                            </StackPanel>
                                            <Border Grid.Column="1">
                                                        <!-- Felder für Fahrer und Fahrzeug: feste Breite, gestrichelt solange leer. -->
                                                        <StackPanel Spacing="6" Width="200" VerticalAlignment="Center">
                                                            <Grid Height="38">
                                                                <Rectangle RadiusX="6" RadiusY="6" StrokeThickness="1.2" Stroke="{x:Bind FahrerRand}"
                                                                           StrokeDashArray="{x:Bind FahrerStrich}" Fill="{x:Bind FahrerFuellung}" />
                                                                <Grid Margin="10,0,4,0" ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <FontIcon Glyph="&#xE77B;" FontSize="14" VerticalAlignment="Center" Foreground="{x:Bind FahrerFarbe}" />
                                                                    <TextBlock Grid.Column="1" Text="{x:Bind FahrerText}" FontSize="14" VerticalAlignment="Center"
                                                                               Foreground="{x:Bind FahrerFarbe}" TextTrimming="CharacterEllipsis" />
                                                                    <Button Grid.Column="2" Content="✕" Tag="{x:Bind Schluessel}" Visibility="{x:Bind FahrerEntfernenSichtbar}"
                                                                            Click="FahrerEntfernen_Click" Background="Transparent" BorderThickness="0" FontSize="11"
                                                                            MinHeight="0" MinWidth="0" Padding="7,3"
                                                                            ToolTipService.ToolTip="Fahrer wieder entfernen" AutomationProperties.Name="Fahrer entfernen" />
                                                                </Grid>
                                                            </Grid>
                                                            <Grid Height="38">
                                                                <Rectangle RadiusX="6" RadiusY="6" StrokeThickness="1.2" Stroke="{x:Bind FahrzeugRand}"
                                                                           StrokeDashArray="{x:Bind FahrzeugStrich}" Fill="{x:Bind FahrzeugFuellung}" />
                                                                <Grid Margin="10,0,4,0" ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <FontIcon Glyph="&#xE806;" FontSize="14" VerticalAlignment="Center" Foreground="{x:Bind FahrzeugFarbe}" />
                                                                    <TextBlock Grid.Column="1" Text="{x:Bind FahrzeugText}" FontSize="14" VerticalAlignment="Center"
                                                                               Foreground="{x:Bind FahrzeugFarbe}" TextTrimming="CharacterEllipsis" />
                                                                    <Button Grid.Column="2" Content="✕" Tag="{x:Bind Schluessel}" Visibility="{x:Bind FahrzeugEntfernenSichtbar}"
                                                                            Click="FahrzeugEntfernen_Click" Background="Transparent" BorderThickness="0" FontSize="11"
                                                                            MinHeight="0" MinWidth="0" Padding="7,3"
                                                                            ToolTipService.ToolTip="Fahrzeug wieder entfernen" AutomationProperties.Name="Fahrzeug entfernen" />
                                                                </Grid>
                                                            </Grid>
                                                            <TextBlock Text="{x:Bind Hinweis}" FontSize="13" TextWrapping="Wrap"
                                                                       Foreground="{x:Bind HinweisFarbe}" Visibility="{x:Bind HinweisSichtbar}" />
                                                        </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <!-- Sendungen der Tour -->
                                    <ItemsControl ItemsSource="{x:Bind Sendungen}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:VerplanteZeile">
                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10,14,10">
                                                    <StackPanel>
                                                    <Grid ColumnSpacing="16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Titel}" Style="{StaticResource NormalText}" FontSize="15"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="{x:Bind Zeile1}" Style="{StaticResource HinweisText}"
                                                                       TextWrapping="WrapWholeWords" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1" VerticalAlignment="Center">
                                                            <Border CornerRadius="11" Padding="10,2" BorderThickness="1" VerticalAlignment="Center" Visibility="{x:Bind StatusSichtbar}"
                                    Background="{x:Bind StatusHintergrund}" BorderBrush="{x:Bind StatusRand}">
                                <TextBlock Text="{x:Bind Status}" FontSize="13" FontWeight="SemiBold" Foreground="{x:Bind StatusSchrift}" />
                            </Border>
                                                        </Border>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                                        <Button Tag="{x:Bind Id}" Click="Aufklappen_Click" Style="{StaticResource DashboardButton}" Padding="10,6" MinHeight="0"
                                                                VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Details.PfeilTipp}"
                                                                AutomationProperties.Name="{x:Bind Details.PfeilTipp}">
                                                            <FontIcon Glyph="{x:Bind Details.PfeilGlyph}" FontSize="14" />
                                                        </Button>
                                                        <Button Style="{StaticResource DashboardButton}" Padding="10,6" MinHeight="0" VerticalAlignment="Center"
                                                                            ToolTipService.ToolTip="Weitere Aktionen" AutomationProperties.Name="Weitere Aktionen">
                                                                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                                                                        <Button.Flyout>
                                                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                                <MenuFlyoutItem Text="Details" Tag="{x:Bind Id}" Click="Details_Click">
                                                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                                                                                </MenuFlyoutItem>
                                                                                <MenuFlyoutItem Text="Aus Tour nehmen …" Tag="{x:Bind Id}" Click="Loesen_Click"
                                                                                                Visibility="{x:Bind LoesenSichtbar}">
                                                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;" /></MenuFlyoutItem.Icon>
                                                                                </MenuFlyoutItem>
                                                                            </MenuFlyout>
                                                                        </Button.Flyout>
                                                                    </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                    <!-- Aufgeklappt: links eine kompakte Liste mit Trennlinien (Strecke A → B, Ladung, Vor Ort, Auftrag),
                                                         rechts ein Kartenausschnitt mit der Strecke. -->
                                                    <Grid Visibility="{x:Bind Details.Sichtbar}" Margin="0,12,0,2" ColumnSpacing="16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="3*" />
                                                            <ColumnDefinition Width="2*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{x:Bind Details.LadeText}" Style="{StaticResource HinweisText}"
                                                                   Visibility="{x:Bind Details.LadeSichtbar}" />
                                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,0"
                                                                Visibility="{x:Bind Details.InhaltSichtbar}">
                                                            <StackPanel>
                                                                <!-- Strecke: A und B mit Verbindungslinie, Zeitfenster rechtsbündig -->
                                                                <Grid ColumnSpacing="10" RowSpacing="6" Padding="0,10">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="20" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <Rectangle Grid.RowSpan="2" Width="2" Margin="0,12,0,12" HorizontalAlignment="Center"
                                                                               Fill="{StaticResource BorderBrush}" />
                                                                    <Border Width="20" Height="20" CornerRadius="10" VerticalAlignment="Top" Margin="0,1,0,0"
                                                                            Background="{x:Bind Details.AbholFarbe}">
                                                                        <TextBlock Text="A" Foreground="White" FontWeight="Bold" FontSize="11"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <TextBlock Grid.Column="1" Text="{x:Bind Details.AbholAdresse}" Style="{StaticResource NormalText}"
                                                                               FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                                    <TextBlock Grid.Column="2" Text="{x:Bind Details.AbholZeit}" Style="{StaticResource HinweisText}"
                                                                               FontSize="13" Margin="0,1,0,0" />
                                                                    <Border Grid.Row="1" Width="20" Height="20" CornerRadius="10" VerticalAlignment="Top" Margin="0,1,0,0"
                                                                            Background="{x:Bind Details.ZustellFarbe}">
                                                                        <TextBlock Text="B" Foreground="White" FontWeight="Bold" FontSize="11"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Details.ZustellAdresse}" Style="{StaticResource NormalText}"
                                                                               FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Bind Details.ZustellZeit}" Style="{StaticResource HinweisText}"
                                                                               FontSize="13" Margin="0,1,0,0" />
                                                                </Grid>
                                                                <Rectangle Height="1" Fill="{StaticResource BorderBrush}" />

                                                                <!-- Ladung -->
                                                                <Grid ColumnSpacing="10" Padding="0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="72" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="Ladung" Style="{StaticResource HinweisText}" FontSize="13" FontWeight="SemiBold" />
                                                                    <StackPanel Grid.Column="1" Spacing="4">
                                                                        <TextBlock Text="{x:Bind Details.LadungZeile1}" Style="{StaticResource NormalText}" FontSize="14"
                                                                                   TextWrapping="Wrap" />
                                                                        <TextBlock Text="{x:Bind Details.LadungZeile2}" Style="{StaticResource HinweisText}" FontSize="13"
                                                                                   TextWrapping="Wrap" />
                                                                        <ItemsRepeater ItemsSource="{x:Bind Details.Merkmale}" Visibility="{x:Bind Details.MerkmaleSichtbar}"
                                                                                       Margin="0,2,0,0">
                                                                            <ItemsRepeater.Layout>
                                                                                <StackLayout Orientation="Horizontal" Spacing="6" />
                                                                            </ItemsRepeater.Layout>
                                                                            <ItemsRepeater.ItemTemplate>
                                                                                <DataTemplate x:DataType="local:DetailMerkmal">
                                                                                    <Border Background="{x:Bind Hintergrund}" BorderBrush="{x:Bind Rand}" BorderThickness="1"
                                                                                            CornerRadius="9" Padding="8,1">
                                                                                        <TextBlock Text="{x:Bind Text}" Foreground="{x:Bind Schrift}" FontSize="12" FontWeight="SemiBold" />
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </ItemsRepeater.ItemTemplate>
                                                                        </ItemsRepeater>
                                                                    </StackPanel>
                                                                </Grid>
                                                                <Rectangle Height="1" Fill="{StaticResource BorderBrush}" />

                                                                <!-- Vor Ort -->
                                                                <Grid ColumnSpacing="10" Padding="0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="72" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="Vor Ort" Style="{StaticResource HinweisText}" FontSize="13" FontWeight="SemiBold" />
                                                                    <TextBlock Grid.Column="1" Text="{x:Bind Details.VorOrt}" Style="{StaticResource NormalText}" FontSize="14"
                                                                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                                    <Border Grid.Column="2" Background="{x:Bind Details.Avisierung.Hintergrund}" BorderBrush="{x:Bind Details.Avisierung.Rand}"
                                                                            BorderThickness="1" CornerRadius="9" Padding="8,1" VerticalAlignment="Top"
                                                                            Visibility="{x:Bind Details.AvisierungSichtbar}">
                                                                        <TextBlock Text="{x:Bind Details.Avisierung.Text}" Foreground="{x:Bind Details.Avisierung.Schrift}"
                                                                                   FontSize="12" FontWeight="SemiBold" />
                                                                    </Border>
                                                                </Grid>
                                                                <Rectangle Height="1" Fill="{StaticResource BorderBrush}" />

                                                                <!-- Auftrag -->
                                                                <Grid ColumnSpacing="10" Padding="0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="72" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="Auftrag" Style="{StaticResource HinweisText}" FontSize="13" FontWeight="SemiBold" />
                                                                    <TextBlock Grid.Column="1" Text="{x:Bind Details.Auftrag}" Style="{StaticResource NormalText}" FontSize="14"
                                                                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                                    <Border Grid.Column="2" Background="{x:Bind Details.Prioritaet.Hintergrund}" BorderBrush="{x:Bind Details.Prioritaet.Rand}"
                                                                            BorderThickness="1" CornerRadius="9" Padding="8,1" VerticalAlignment="Top">
                                                                        <TextBlock Text="{x:Bind Details.Prioritaet.Text}" Foreground="{x:Bind Details.Prioritaet.Schrift}"
                                                                                   FontSize="12" FontWeight="SemiBold" />
                                                                    </Border>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <!-- Kartenausschnitt: WebView2 wird erst beim Aufklappen erzeugt (Strecke_Loaded). So hoch wie die Liste links. -->
                                                        <Border Grid.Column="1" MinHeight="200" CornerRadius="6" BorderThickness="1"
                                                                BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource InputBrush}"
                                                                Visibility="{x:Bind Details.InhaltSichtbar}" Tag="{x:Bind Id}"
                                                                Loaded="Strecke_Loaded" Unloaded="Strecke_Unloaded" />
                                                    </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="VerplantLeerText" Visibility="Collapsed" Style="{StaticResource HinweisText}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        </StackPanel>

        <!-- Verfügbar am gewählten Tag. Wandert beim Scrollen mit (VerfuegbarNachziehen im Code-Behind),
             damit man Fahrer/Fahrzeuge auch auf Sendungen weiter unten ziehen kann. -->
        <Border x:Name="VerfuegbarKarte" Grid.Column="1" Style="{StaticResource KarteStyle}" VerticalAlignment="Top"
                Padding="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="VerfuegbarVerschiebung" />
            </Border.RenderTransform>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10" Padding="20,18">
                <TextBlock x:Name="VerfuegbarTitel" Text="Verfügbar" Style="{StaticResource UeberschriftText}" />
                    <TextBlock x:Name="FahrerTitel" Text="Fahrer" Style="{StaticResource NormalText}" FontWeight="SemiBold" />
                    <ListView x:Name="FahrerListe" SelectionMode="None" MaxHeight="340" Margin="-4,0"
                              CanDragItems="True" DragItemsStarting="Verfuegbar_DragItemsStarting"
                              DragItemsCompleted="Verfuegbar_DragItemsCompleted" AutomationProperties.Name="Fahrer">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="4,0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:VerfuegbarZeile">
                                <!-- Karte mit Griff links: zeigt, dass man sie auf eine Sendung ziehen kann. -->
                                <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="8,8,10,8"
                                        ToolTipService.ToolTip="Auf eine unverplante Sendung ziehen">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE784;" FontSize="14" VerticalAlignment="Center"
                                                  Foreground="{StaticResource MutedTextBrush}" />
                                        <Border Grid.Column="1" Width="30" Height="30" CornerRadius="15" VerticalAlignment="Center"
                                                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <FontIcon Glyph="&#xE77B;" FontSize="14" Foreground="{StaticResource TextBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Titel}" Style="{StaticResource NormalText}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Details}" Style="{StaticResource HinweisText}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Belegung}" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{x:Bind BelegungFarbe}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="FahrerLeerText" Style="{StaticResource HinweisText}" FontSize="13" TextWrapping="Wrap"
                               Visibility="Collapsed" Text="An diesem Tag ist kein Fahrer einsetzbar." />
                    <TextBlock x:Name="FahrzeugTitel" Text="Fahrzeuge" Style="{StaticResource NormalText}" FontWeight="SemiBold" />
                    <ListView x:Name="FahrzeugListe" SelectionMode="None" MaxHeight="340" Margin="-4,0"
                              CanDragItems="True" DragItemsStarting="Verfuegbar_DragItemsStarting"
                              DragItemsCompleted="Verfuegbar_DragItemsCompleted" AutomationProperties.Name="Fahrzeuge">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="4,0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:VerfuegbarZeile">
                                <!-- Karte mit Griff links: zeigt, dass man sie auf eine Sendung ziehen kann. -->
                                <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="8,8,10,8"
                                        ToolTipService.ToolTip="Auf eine unverplante Sendung ziehen">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE784;" FontSize="14" VerticalAlignment="Center"
                                                  Foreground="{StaticResource MutedTextBrush}" />
                                        <Border Grid.Column="1" Width="30" Height="30" CornerRadius="15" VerticalAlignment="Center"
                                                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <FontIcon Glyph="&#xE806;" FontSize="14" Foreground="{StaticResource TextBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Titel}" Style="{StaticResource NormalText}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Details}" Style="{StaticResource HinweisText}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Belegung}" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{x:Bind BelegungFarbe}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="FahrzeugLeerText" Style="{StaticResource HinweisText}" FontSize="13" TextWrapping="Wrap"
                               Visibility="Collapsed" Text="An diesem Tag ist kein Fahrzeug einsetzbar." />
            </StackPanel>
            </ScrollViewer>
        </Border>
        </Grid>
    </StackPanel>
</UserControl>
