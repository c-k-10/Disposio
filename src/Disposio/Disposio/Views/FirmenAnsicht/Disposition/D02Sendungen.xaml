<?xml version="1.0" encoding="utf-8"?>
<!-- D02 „Sendungen“: Aufträge eines Tages suchen und zur Planung auswählen. „+ Sendung erfassen“ und „Details“
     öffnen D03, „Planungsvorschlag prüfen“ öffnet D13 und „Manuell verplanen“ die Tourplanung D05,
     jeweils mit den angehakten Sendungen. -->
<UserControl
    x:Class="Disposio.Views.D02Sendungen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Disposio.Views">

    <StackPanel Spacing="18">
        <!-- Leiste mit Anzahl unverplanter Sendungen und „+ Sendung erfassen“ -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="5" Background="{StaticResource AccentBrush}" CornerRadius="12,0,0,12" />
                <TextBlock x:Name="UnverplantText" Grid.Column="1" Style="{StaticResource NormalText}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="22,0" Text="Sendungen werden geladen …" />
                <Button Grid.Column="2" Content="+ Sendung erfassen" Style="{StaticResource PrimaryButton}"
                        Margin="0,14,18,14" Click="SendungErfassen_Click" />
            </Grid>
        </Border>

        <!-- Filter. Datum lädt neu aus der Datenbank, Suche und Status filtern die geladene Liste. -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="220" />
                <ColumnDefinition Width="*" MinWidth="170" />
                <ColumnDefinition Width="1.3*" MinWidth="190" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Kundenreferenz / Ort" Style="{StaticResource FeldLabel}" />
                <TextBox x:Name="SuchBox" Style="{StaticResource FormTextBox}" PlaceholderText="Begriff eingeben"
                         KeyDown="SuchBox_KeyDown" AutomationProperties.Name="Kundenreferenz oder Ort suchen" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Status" Style="{StaticResource FeldLabel}" />
                <ComboBox x:Name="StatusAuswahl" Style="{StaticResource FormComboBox}" AutomationProperties.Name="Status" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Datum" Style="{StaticResource FeldLabel}" />
                <CalendarDatePicker x:Name="DatumAuswahl" Style="{StaticResource FormDatePicker}"
                                    DateFormat="{}{day.integer(2)}.{month.integer(2)}.{year.full}"
                                    FirstDayOfWeek="Monday" AutomationProperties.Name="Datum" />
            </StackPanel>
            <Button Grid.Column="3" Content="Filter anwenden" Style="{StaticResource DashboardButton}"
                    VerticalAlignment="Bottom" Click="FilterAnwenden_Click" />
        </Grid>

        <Border Style="{StaticResource KarteStyle}">
            <StackPanel Spacing="12">
                <Grid>
                    <TextBlock Text="Sendungsliste" Style="{StaticResource UeberschriftText}" />
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ProgressRing x:Name="LadeAnzeige" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource HinweisText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Kopfzeile und Zeilen haben dieselben Spaltenbreiten. Erste Spalte: Häkchen zur Planung. -->
                <Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="14,10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Referenz / Kunde" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Abholung → Zustellung" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Fenster" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="Gut / Kapazität" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="5" Text="Status" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                    </Grid>
                </Border>

                <ItemsControl x:Name="SendungListe">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:SendungListenZeile">
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Nur unverplante Sendungen lassen sich zur Planung auswählen. -->
                                    <CheckBox IsChecked="{x:Bind Ausgewaehlt}" IsEnabled="{x:Bind KannGeplantWerden}"
                                              Tag="{x:Bind Id}" Click="Auswahl_Click" MinWidth="0" VerticalAlignment="Center"
                                              AutomationProperties.Name="Zur Planung auswählen" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ReferenzUndKunde}" Style="{StaticResource NormalText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Strecke}" Style="{StaticResource NormalText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Fenster}" Style="{StaticResource NormalText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind GutUndKapazitaet}" Style="{StaticResource NormalText}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="5" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Status}" Style="{StaticResource NormalText}" />
                                        <TextBlock Text="{x:Bind TourText}" Style="{StaticResource HinweisText}" FontSize="13"
                                                   Visibility="{x:Bind TourSichtbar}" />
                                    </StackPanel>
                                    <Button Grid.Column="6" Content="Details" Tag="{x:Bind Id}"
                                            Style="{StaticResource DashboardButton}" MinHeight="36" Padding="14,4"
                                            HorizontalAlignment="Left" Click="Details_Click" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="LeerText" Visibility="Collapsed" Style="{StaticResource HinweisText}" />
            </StackPanel>
        </Border>

        <!-- Planung der angehakten Sendungen -->
        <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="VorschlagButton" Content="Planungsvorschlag prüfen" Style="{StaticResource PrimaryButton}"
                        IsEnabled="False" Click="Planungsvorschlag_Click" />
                <Button x:Name="ManuellButton" Content="Manuell verplanen" Style="{StaticResource DashboardButton}"
                        IsEnabled="False" Click="ManuellVerplanen_Click" />
            </StackPanel>
            <TextBlock x:Name="AuswahlText" Style="{StaticResource HinweisText}"
                       Text="Haken Sie unverplante Sendungen an, um sie zu einer Tour zusammenzustellen." />
        </StackPanel>
    </StackPanel>
</UserControl>
