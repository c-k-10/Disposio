<?xml version="1.0" encoding="utf-8"?>
<!-- D08 „Live-Karte & Verkehr“: links Suche nach Fahrer oder Kennzeichen, rechts die OpenStreetMap-Karte
     (Leaflet) im WebView2 mit Verkehrslage von TomTom und den Live-Positionen aus der Fahrer-App. -->
<UserControl
    x:Class="Disposio.Views.D08LiveKarte"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Disposio.Views">

    <StackPanel Spacing="18">
        <!-- Status links, Schalter für die beiden Verkehrsebenen und Filter für die Störungsarten rechts -->
        <Grid ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Grid statt waagrechtem StackPanel: So bricht ein langer Status in eine zweite Zeile um,
                 statt abgeschnitten zu werden. -->
            <Grid ColumnSpacing="12" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ProgressRing x:Name="LadeAnzeige" Width="20" Height="20" IsActive="True" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Style="{StaticResource HinweisText}" VerticalAlignment="Center"
                           TextWrapping="Wrap" Text="Karte wird geladen …" />
            </Grid>
            <!-- Lädt Verkehrsfluss, Störungen und die Liste Fahrer & Fahrzeuge sofort neu. -->
            <Button x:Name="AktualisierenKnopf" Grid.Column="1" IsEnabled="False" VerticalAlignment="Bottom"
                    Style="{StaticResource DashboardButton}" Click="Aktualisieren_Click"
                    AutomationProperties.Name="Karte und Liste jetzt aktualisieren"
                    ToolTipService.ToolTip="Verkehrslage, Störungen und Liste jetzt neu laden">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="15" />
                    <TextBlock x:Name="AktualisierenText" Text="Aktualisieren" />
                </StackPanel>
            </Button>
            <ToggleSwitch x:Name="FlussSchalter" Grid.Column="2" IsOn="True" IsEnabled="False"
                          Header="Verkehrsfluss" OnContent="An" OffContent="Aus"
                          Toggled="EbenenSchalter_Toggled" AutomationProperties.Name="Verkehrsfluss anzeigen" />
            <ToggleSwitch x:Name="StoerungenSchalter" Grid.Column="3" IsOn="True" IsEnabled="False"
                          Header="Störungen" OnContent="An" OffContent="Aus"
                          Toggled="EbenenSchalter_Toggled" AutomationProperties.Name="Verkehrsstörungen anzeigen" />

            <!-- Welche Störungen gezeigt werden. Gefiltert wird in der Karte, ohne neue TomTom-Abfrage. -->
            <StackPanel Grid.Column="4" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="Störungsarten" FontSize="14" Foreground="{StaticResource TextBrush}" />
                <DropDownButton x:Name="ArtenKnopf" Content="Alle Arten" IsEnabled="False" Width="190"
                                MinHeight="36" CornerRadius="10" Background="{StaticResource InputBrush}"
                                BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource TextBrush}"
                                AutomationProperties.Name="Störungsarten auswählen">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <ToggleMenuFlyoutItem x:Name="ArtStau" Text="Stau" Tag="Stau" IsChecked="True" Click="StoerungsArt_Click" />
                            <ToggleMenuFlyoutItem x:Name="ArtUnfall" Text="Unfälle" Tag="Unfälle" IsChecked="True" Click="StoerungsArt_Click" />
                            <ToggleMenuFlyoutItem x:Name="ArtBaustelle" Text="Baustellen" Tag="Baustellen" IsChecked="True" Click="StoerungsArt_Click" />
                            <ToggleMenuFlyoutItem x:Name="ArtSperrung" Text="Sperrungen" Tag="Sperrungen" IsChecked="True" Click="StoerungsArt_Click" />
                            <ToggleMenuFlyoutItem x:Name="ArtSonstige" Text="Wetter, Gefahren &amp; Pannen" Tag="Sonstige" IsChecked="True" Click="StoerungsArt_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Alle auswählen" Click="AlleArten_Click" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <Grid ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Suche und Filter -->
            <Border Style="{StaticResource KarteStyle}" Padding="20,20">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Fahrer &amp; Fahrzeuge" Style="{StaticResource UeberschriftText}" />

                    <TextBox x:Name="SuchBox" Grid.Row="1" Style="{StaticResource FormTextBox}"
                             PlaceholderText="Fahrer oder Kennzeichen suchen …"
                             TextChanged="Suche_TextChanged" AutomationProperties.Name="Fahrer oder Kennzeichen suchen" />

                    <ComboBox x:Name="ArtAuswahl" Grid.Row="2" Style="{StaticResource FormComboBox}"
                              HorizontalAlignment="Stretch" SelectedIndex="0"
                              SelectionChanged="ArtAuswahl_SelectionChanged" AutomationProperties.Name="Anzeigen">
                        <ComboBoxItem Content="Fahrer und Fahrzeuge" />
                        <ComboBoxItem Content="Nur Fahrer" />
                        <ComboBoxItem Content="Nur Fahrzeuge" />
                    </ComboBox>

                    <TextBlock x:Name="TrefferText" Grid.Row="3" Style="{StaticResource HinweisText}" />

                    <!-- Höhe passend zur Karte rechts. Die Liste scrollt selbst.
                         Sind unten die Details offen, wird sie im Code niedriger (ListenHoeheMitDetails). -->
                    <ListView x:Name="TrefferListe" Grid.Row="4" Height="430" SelectionMode="Single"
                              Margin="-12,0" SelectionChanged="TrefferListe_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:KartenZeile">
                                <Grid ColumnSpacing="12" Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="18" VerticalAlignment="Center"
                                            Background="{StaticResource InputBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <FontIcon Glyph="{x:Bind Symbol}" FontSize="16" Foreground="{StaticResource TextBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource NormalText}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Details}" Style="{StaticResource HinweisText}" FontSize="13" />
                                        <TextBlock Text="{x:Bind PositionText}" Style="{StaticResource HinweisText}" FontSize="12" Opacity="0.75" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="AuswahlHinweis" Grid.Row="5" Style="{StaticResource HinweisText}"
                               TextWrapping="Wrap" Visibility="Collapsed" />

                    <!-- Details zum ausgewählten Fahrzeug: erscheinen beim Klick in die Liste oder auf einen Marker,
                         wenn das Fahrzeug gerade eine aktive Tour hat. Werden mit den Positionen alle 30 s erneuert. -->
                    <Border x:Name="DetailsRahmen" Grid.Row="6" Visibility="Collapsed" Padding="14,12"
                            CornerRadius="12" BorderThickness="1"
                            Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}">
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DetailsTitel" Style="{StaticResource NormalText}" FontWeight="SemiBold"
                                           FontSize="16" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Click="DetailsSchliessen_Click" Padding="6"
                                        Background="Transparent" BorderThickness="0"
                                        AutomationProperties.Name="Details schließen"
                                        ToolTipService.ToolTip="Details schließen">
                                    <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                </Button>
                            </Grid>
                            <TextBlock x:Name="DetailsUntertitel" Style="{StaticResource HinweisText}" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailsStatus" Style="{StaticResource NormalText}" FontSize="13" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailsNaechsterStopp" Style="{StaticResource NormalText}" FontSize="13" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailsFortschritt" Style="{StaticResource HinweisText}" FontSize="13" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="8" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="Tour öffnen" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"
                                        Click="DetailsTour_Click" AutomationProperties.Name="Tourdetails öffnen" />
                                <Button Grid.Column="1" Content="Chat öffnen" Style="{StaticResource DashboardButton}"
                                        HorizontalAlignment="Stretch" Click="DetailsChat_Click"
                                        AutomationProperties.Name="Chat mit dem Fahrer öffnen" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Karte -->
            <Border x:Name="KarteRahmen" Grid.Column="1" Style="{StaticResource KarteStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Karte" Style="{StaticResource UeberschriftText}" />
                    <!-- Die Seite liegt in einem ScrollViewer, deshalb braucht die Karte eine feste Höhe. -->
                    <WebView2 x:Name="Karte" Height="600" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
