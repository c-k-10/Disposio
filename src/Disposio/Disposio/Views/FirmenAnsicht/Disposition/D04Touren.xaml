<?xml version="1.0" encoding="utf-8"?>
<!-- D04 „Tourenübersicht“ im Stil der Fahrer-App: Kennzahlen, Filter und je Tour eine Karte
     (wie „Meine Touren“ in der Fahrer-App). „+ Neue Tour“ öffnet D05, „Öffnen“ die Tourdetails (D07),
     „Zuweisen“ die Zuweisung (D06). -->
<UserControl
    x:Class="Disposio.Views.D04Touren"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Disposio.Views">

    <StackPanel Spacing="14">
        <!-- Datum links (leise), „+ Neue Tour“ rechts -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DatumText" Style="{StaticResource HinweisText}" FontSize="15" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="+ Neue Tour" Style="{StaticResource PrimaryButton}" Click="TourPlanen_Click" />
        </Grid>

        <!-- Kennzahlen des Tages, wie in den Entwürfen -->
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource KarteStyle}" Padding="16,12">
                <StackPanel Spacing="2">
                    <TextBlock Text="Unterwegs" Style="{StaticResource HinweisText}" FontSize="13" />
                    <TextBlock x:Name="KpiUnterwegs" Text="–" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource KarteStyle}" Padding="16,12">
                <StackPanel Spacing="2">
                    <TextBlock Text="Verspätet" Style="{StaticResource HinweisText}" FontSize="13" />
                    <TextBlock x:Name="KpiVerspaetet" Text="–" FontSize="24" FontWeight="Bold" Foreground="{StaticResource LateBrush}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource KarteStyle}" Padding="16,12">
                <StackPanel Spacing="2">
                    <TextBlock Text="Geplant" Style="{StaticResource HinweisText}" FontSize="13" />
                    <TextBlock x:Name="KpiGeplant" Text="–" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource KarteStyle}" Padding="16,12">
                <StackPanel Spacing="2">
                    <TextBlock Text="Abgeschlossen" Style="{StaticResource HinweisText}" FontSize="13" />
                    <TextBlock x:Name="KpiAbgeschlossen" Text="–" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Filter. Datum lädt neu aus der Datenbank, Suche und Status filtern die geladene Liste. -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="220" />
                <ColumnDefinition Width="*" MinWidth="170" />
                <ColumnDefinition Width="1.3*" MinWidth="190" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SuchBox" Style="{StaticResource FormTextBox}" PlaceholderText="Tour, Fahrer oder Ort suchen"
                     KeyDown="SuchBox_KeyDown" AutomationProperties.Name="Tour, Fahrer oder Ort suchen" />
            <ComboBox x:Name="StatusAuswahl" Grid.Column="1" Style="{StaticResource FormComboBox}" AutomationProperties.Name="Status" />
            <CalendarDatePicker x:Name="DatumAuswahl" Grid.Column="2" Style="{StaticResource FormDatePicker}"
                                DateFormat="{}{day.integer(2)}.{month.integer(2)}.{year.full}"
                                FirstDayOfWeek="Monday" AutomationProperties.Name="Datum" />
            <Button Grid.Column="3" Content="Filter anwenden" Style="{StaticResource DashboardButton}" Click="FilterAnwenden_Click" />
        </Grid>

        <Grid>
            <TextBlock Text="Touren" Style="{StaticResource UeberschriftText}" FontSize="17" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ProgressRing x:Name="LadeAnzeige" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" Style="{StaticResource HinweisText}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Jede Tour eine Karte wie in der Fahrer-App. Klick markiert (Strich links), Doppelklick öffnet. -->
        <ItemsControl x:Name="TourListe">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:TourZeile">
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
                    <Border local:ListenZeile.Aktiv="True" local:ListenZeile.Markiert="{x:Bind IstMarkiert}"
                            Tag="{x:Bind Id}" Tapped="Zeile_Tapped" DoubleTapped="Zeile_DoubleTapped" Loaded="Zeile_Loaded"
                            BorderThickness="3,0,0,0" CornerRadius="4" Padding="15,14,18,14">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Tournummer}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{x:Bind Bereich}" Style="{StaticResource HinweisText}" FontSize="13" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Route}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{x:Bind FahrerUndFahrzeug}" Style="{StaticResource HinweisText}" FontSize="13" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind NaechsterStopp}" Style="{StaticResource HinweisText}" FontSize="13" />
                                <TextBlock Text="{x:Bind EtaText}" Visibility="{x:Bind EtaNormalSichtbar}" Style="{StaticResource EtaText}" />
                                <TextBlock Text="{x:Bind EtaText}" Visibility="{x:Bind EtaVerspaetetSichtbar}" Style="{StaticResource EtaVerspaetetText}" />
                            </StackPanel>

                            <!-- Status-Etikett wie StatusBadge der Fahrer-App -->
                            <Grid Grid.Column="3" VerticalAlignment="Center">
                                <Border Style="{StaticResource BadgeAktiv}" Visibility="{x:Bind AktivSichtbar}">
                                    <TextBlock Text="{x:Bind Status}" Style="{StaticResource BadgeAktivText}" />
                                </Border>
                                <Border Style="{StaticResource BadgeOffen}" Visibility="{x:Bind OffenSichtbar}">
                                    <TextBlock Text="{x:Bind Status}" Style="{StaticResource BadgeOffenText}" />
                                </Border>
                                <Border Style="{StaticResource BadgeErledigt}" Visibility="{x:Bind ErledigtSichtbar}">
                                    <TextBlock Text="{x:Bind Status}" Style="{StaticResource BadgeErledigtText}" />
                                </Border>
                                <Border Style="{StaticResource BadgeOffen}" BorderBrush="{StaticResource LateBrush}" Visibility="{x:Bind VerspaetetSichtbar}">
                                    <TextBlock Text="{x:Bind Status}" Style="{StaticResource BadgeOffenText}" Foreground="{StaticResource LateBrush}" />
                                </Border>
                            </Grid>

                            <Button Grid.Column="4" Content="{x:Bind AktionText}" Tag="{x:Bind Id}"
                                    Style="{StaticResource DashboardButton}" MinHeight="36" Padding="14,4"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="TourAktion_Click" />
                        </Grid>
                    </Border>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="LeerText" Visibility="Collapsed" Style="{StaticResource HinweisText}" />
    </StackPanel>
</UserControl>
