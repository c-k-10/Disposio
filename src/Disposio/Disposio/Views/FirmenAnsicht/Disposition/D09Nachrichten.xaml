<?xml version="1.0" encoding="utf-8"?>
<!-- D09 „Nachrichten mit Fahrer“: links die Touren mit Fahrer (heute, unterwegs oder mit neuen Nachrichten),
     rechts der Verlauf. Nachrichten des Fahrers erscheinen übersetzt, das Original lässt sich aufklappen.
     Eigene Nachrichten werden sofort im Original gespeichert und danach von der Neon Function „uebersetzen“
     übersetzt. Fällt die Übersetzung aus, bleibt das Original sichtbar und „Erneut übersetzen“ erscheint.
     Aufbau wie ein Messenger: Die Ansicht füllt genau den sichtbaren Bereich (Höhe setzt der Code), die Seite
     scrollt also nicht. Es scrollen nur die Fahrerliste links und der Verlauf rechts; Kopf und Eingabe bleiben stehen. -->
<UserControl
    x:Class="Disposio.Views.D09Nachrichten"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Disposio.Views">

    <Grid x:Name="Wurzel" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Links: Gespräche ─────────────────────────────────────────────────────── -->
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBox x:Name="SucheBox" Style="{StaticResource FormTextBox}"
                     PlaceholderText="Fahrer, Tour oder Kennzeichen suchen"
                     TextChanged="Suche_TextChanged" AutomationProperties.Name="Fahrer oder Tour suchen" />

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
                <ProgressRing x:Name="ListeLadeAnzeige" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                <TextBlock x:Name="ListeStatusText" Style="{StaticResource HinweisText}" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Nur diese Liste scrollt, nicht die ganze Seite. -->
            <ListView x:Name="GespraechListe" Grid.Row="2" SelectionMode="Single" SelectionChanged="Gespraech_SelectionChanged"
                      Padding="0,0,12,0" AutomationProperties.Name="Fahrer und Touren">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:GespraechZeile">
                        <!-- Der geöffnete Chat: Akzentrahmen, in der Firmenfarbe getönt und Balken links (wie die markierten Zeilen in D02). -->
                        <Border Background="{x:Bind Hintergrund}" BorderBrush="{x:Bind Rahmen}"
                                BorderThickness="{x:Bind Rahmenstaerke}" CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="5" Background="{StaticResource AccentBrush}" CornerRadius="4,0,0,4"
                                        Visibility="{x:Bind BalkenSichtbar}" />
                                <!-- Kürzel | Name + Tour | Zeit + Anzahl neuer Nachrichten -->
                                <Grid Grid.Column="1" ColumnSpacing="12" Margin="{x:Bind Innenabstand}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="19" VerticalAlignment="Center"
                                            Background="{StaticResource StatusBoxBrush}">
                                        <TextBlock Text="{x:Bind Kuerzel}" FontSize="13" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind FahrerName}" FontSize="15" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="{x:Bind TourUndFahrzeug}" FontSize="13" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                        <!-- Nur bei ungelesenen Nachrichten: „● 2 neue Nachrichten“ in der Akzentfarbe -->
                                        <TextBlock Text="{x:Bind NeuText}" Visibility="{x:Bind UngelesenSichtbar}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind Zeit}" FontSize="12" HorizontalAlignment="Right"
                                                   Foreground="{x:Bind ZeitFarbe}" FontWeight="{x:Bind ZeitSchrift}"
                                                   ToolTipService.ToolTip="{x:Bind ZeitErklaerung}" />
                                        <!-- Anzahl ungelesener Nachrichten -->
                                        <Border HorizontalAlignment="Right" MinWidth="22" Background="{StaticResource AccentBrush}"
                                                CornerRadius="11" Padding="7,1" Visibility="{x:Bind UngelesenSichtbar}"
                                                AutomationProperties.Name="{x:Bind ZeitErklaerung}">
                                            <TextBlock Text="{x:Bind UngelesenText}" FontSize="12" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" Foreground="{StaticResource AccentTextBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="ListeLeer" Grid.Row="2" Visibility="Collapsed" Style="{StaticResource HinweisText}"
                       Text="Heute gibt es keine Touren mit zugewiesenem Fahrer." />
        </Grid>

        <!-- ── Rechts: Chatfenster. Kopf und Eingabe stehen fest, nur der Verlauf scrollt. ── -->
        <Border Grid.Column="1" Style="{StaticResource KarteStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Kopf: Fahrer, Tour, Sprache, Sprung zu den Tourdetails -->
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="KopfAvatar" Width="42" Height="42" CornerRadius="21" VerticalAlignment="Center"
                                Background="{StaticResource AccentBrush}" Visibility="Collapsed">
                            <TextBlock x:Name="KopfKuerzel" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{StaticResource AccentTextBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="KopfText" Text="Kein Chat geöffnet" Style="{StaticResource UeberschriftText}"
                                       FontSize="18" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <!-- Welche Tour gehört zu diesem Chat, und wird übersetzt? -->
                            <TextBlock x:Name="KopfUnterText" Style="{StaticResource HinweisText}" FontSize="13"
                                       Text="Links einen Fahrer wählen, um den Verlauf zu sehen." />
                        </StackPanel>
                        <Button x:Name="TourdetailsButton" Grid.Column="2" Content="Tourdetails" VerticalAlignment="Center"
                                Style="{StaticResource DashboardButton}" Visibility="Collapsed" Click="Tourdetails_Click"
                                ToolTipService.ToolTip="Tour in D07 öffnen" />
                    </Grid>
                </Border>

                <!-- Verlauf -->
                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="VerlaufScroller" VerticalScrollBarVisibility="Auto" Padding="20,16"
                                  ViewChanged="Verlauf_ViewChanged">
                        <ItemsControl x:Name="VerlaufListe">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:NachrichtZeile">
                                    <StackPanel Spacing="10" Margin="0,0,0,10">
                                        <!-- Tagestrenner „Heute“, „Gestern“, „Montag, 16. November“ -->
                                        <Border HorizontalAlignment="Center" Background="{StaticResource StatusBoxBrush}"
                                                CornerRadius="4" Padding="12,3" Margin="0,6,0,4" Visibility="{x:Bind TagSichtbar}">
                                            <TextBlock Text="{x:Bind Tagestrenner}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                        </Border>
                                        <!-- Trennlinie „Neue Nachrichten“ über der ersten ungelesenen Nachricht des Fahrers -->
                                        <Grid ColumnSpacing="12" Margin="0,4,0,2" Visibility="{x:Bind NeuTrennerSichtbar}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Height="1" Background="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="Neue Nachrichten" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}" />
                                            <Border Grid.Column="2" Height="1" Background="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                        <!-- Fahrer links, Disponent rechts -->
                                        <Border HorizontalAlignment="{x:Bind Ausrichtung}" MaxWidth="620"
                                                Background="{x:Bind Hintergrund}" BorderBrush="{x:Bind Rahmen}"
                                                BorderThickness="{x:Bind RahmenDicke}" CornerRadius="4" Padding="{x:Bind Innenabstand}">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind Absender}" Visibility="{x:Bind AbsenderSichtbar}" FontSize="12"
                                                           FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Text="{x:Bind Haupttext}" Style="{StaticResource NormalText}" FontSize="15"
                                                           IsTextSelectionEnabled="True" />
                                                <!-- Original bzw. Übersetzung zum Prüfen -->
                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="2,0,0,0" Padding="10,2,0,2"
                                                        Visibility="{x:Bind ZweittextSichtbar, Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind Zweittext}" Style="{StaticResource HinweisText}"
                                                               FontStyle="Italic" IsTextSelectionEnabled="True" />
                                                </Border>
                                                <!-- Zeit/Übersetzung links, bei eigenen Nachrichten rechts „✓ Gesendet / ✓✓ Zugestellt / ✓✓ Gelesen“ -->
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Meta}" Style="{StaticResource HinweisText}" FontSize="12" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Zustellung}" Foreground="{x:Bind ZustellungFarbe}"
                                                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Bottom"
                                                               Visibility="{x:Bind ZustellungSichtbar}"
                                                               ToolTipService.ToolTip="{x:Bind ZustellungErklaerung}"
                                                               AutomationProperties.Name="{x:Bind ZustellungErklaerung}" />
                                                </Grid>
                                                <TextBlock Text="{x:Bind Fehlertext}" Style="{StaticResource FehlerText}" FontSize="13"
                                                           Visibility="{x:Bind FehlerSichtbar}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <HyperlinkButton Content="{x:Bind UmschaltText, Mode=OneWay}" Tag="{x:Bind Selbst}"
                                                                     Visibility="{x:Bind UmschaltenSichtbar}" Padding="0,2" FontSize="13"
                                                                     Click="Umschalten_Click" />
                                                    <Button Content="Erneut übersetzen" Tag="{x:Bind Selbst}"
                                                            Visibility="{x:Bind FehlerSichtbar}" Style="{StaticResource DashboardButton}"
                                                            MinHeight="30" Padding="10,2" FontSize="13" Click="ErneutUebersetzen_Click" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="VerlaufLeer" Visibility="Collapsed" Style="{StaticResource HinweisText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="20"
                               Text="Noch keine Nachrichten zu dieser Tour." />

                    <!-- Erscheint, wenn eine neue Nachricht kommt, während man weiter oben liest. -->
                    <Button x:Name="NeuButton" Content="↓ Neue Nachricht" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
                            Visibility="Collapsed" Click="NeuButton_Click" />
                </Grid>

                <!-- Eingabe: bleibt immer unten stehen -->
                <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,14,20,12">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="EingabeBox" Style="{StaticResource FormTextBox}" PlaceholderText="Nachricht schreiben …"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxHeight="140"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" MaxLength="2000" IsEnabled="False"
                                     TextChanged="Eingabe_TextChanged" AutomationProperties.Name="Nachricht an den Fahrer" />
                            <Button x:Name="SendenButton" Grid.Column="1" Content="Senden" Style="{StaticResource PrimaryButton}"
                                    VerticalAlignment="Bottom" MinHeight="44" IsEnabled="False" Click="Senden_Click" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StatusText" Style="{StaticResource HinweisText}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="ZeichenText" Grid.Column="1" Style="{StaticResource HinweisText}" FontSize="12"
                                       VerticalAlignment="Center" Text="Strg + Enter sendet" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
