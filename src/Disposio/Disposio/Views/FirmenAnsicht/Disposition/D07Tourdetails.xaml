<?xml version="1.0" encoding="utf-8"?>
<!-- D07 „Tourdetails“ (aus D04 „Öffnen“): Status, Fahrer, Fahrzeug, Ladung, nächstes Fenster, ETA und alle Stopps.
     „Auf Karte zeigen“ öffnet die Live-Karte (D08) mit den Stopps dieser Tour. -->
<UserControl
    x:Class="Disposio.Views.D07Tourdetails"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Disposio.Views">

    <StackPanel Spacing="18">
        <StackPanel x:Name="LadeBereich" Orientation="Horizontal" Spacing="12">
            <ProgressRing x:Name="LadeAnzeige" Width="20" Height="20" IsActive="True" />
            <TextBlock x:Name="LadeText" Style="{StaticResource HinweisText}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Text="Tour wird geladen …" />
        </StackPanel>

        <!-- Leiste: Tournummer · Bereich · Status, rechts „Auf Karte zeigen“ -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="5" Background="{StaticResource AccentBrush}" CornerRadius="12,0,0,12" />
                <StackPanel Grid.Column="1" Margin="22,12" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="KopfText" Style="{StaticResource NormalText}" FontWeight="SemiBold" Text="Tour" />
                    <TextBlock x:Name="ZeitraumText" Style="{StaticResource HinweisText}" />
                </StackPanel>
                <Button x:Name="KarteButton" Grid.Column="2" Content="Auf Karte zeigen" Style="{StaticResource DashboardButton}"
                        Margin="0,12,18,12" IsEnabled="False" Click="AufKarte_Click" />
            </Grid>
        </Border>

        <!-- Tour im Überblick: 3 × 2 Felder wie im Wireframe -->
        <Border Style="{StaticResource KarteStyle}">
            <StackPanel Spacing="16">
                <TextBlock Text="Tour im Überblick" Style="{StaticResource UeberschriftText}" />
                <Grid ColumnSpacing="24" RowSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Fahrer" Style="{StaticResource HinweisText}" FontSize="13" />
                        <TextBlock x:Name="FahrerText" Style="{StaticResource NormalText}" FontWeight="SemiBold" Text="—" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Fahrzeug" Style="{StaticResource HinweisText}" FontSize="13" />
                        <TextBlock x:Name="FahrzeugText" Style="{StaticResource NormalText}" FontWeight="SemiBold" Text="—" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock Text="Letztes GPS" Style="{StaticResource HinweisText}" FontSize="13" />
                        <TextBlock x:Name="GpsText" Style="{StaticResource NormalText}" FontWeight="SemiBold" Text="—" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="2">
                        <TextBlock Text="Ladung" Style="{StaticResource HinweisText}" FontSize="13" />
                        <TextBlock x:Name="LadungText" Style="{StaticResource NormalText}" FontWeight="SemiBold" Text="—" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                        <TextBlock Text="Nächstes Fenster" Style="{StaticResource HinweisText}" FontSize="13" />
                        <TextBlock x:Name="FensterText" Style="{StaticResource NormalText}" FontWeight="SemiBold" Text="—" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Spacing="2">
                        <TextBlock Text="Aktuelle ETA" Style="{StaticResource HinweisText}" FontSize="13" />
                        <TextBlock x:Name="EtaText" Style="{StaticResource NormalText}" FontWeight="SemiBold" Text="—" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Aktionen. Die Zielansichten bekommen die Tour-Id als Startwert. -->
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="FahrerKontaktButton" Content="Fahrer kontaktieren" Style="{StaticResource DashboardButton}"
                    IsEnabled="False" Click="FahrerKontaktieren_Click" />
            <Button x:Name="KundenButton" Content="Kundeninformation prüfen" Style="{StaticResource PrimaryButton}"
                    IsEnabled="False" Click="Kundeninformation_Click" />
            <Button x:Name="DokumenteButton" Content="Frachtdokumente" Style="{StaticResource DashboardButton}"
                    IsEnabled="False" Click="Frachtdokumente_Click" />
            <Button x:Name="ZuweisenButton" Content="Zuweisung ändern" Style="{StaticResource DashboardButton}"
                    IsEnabled="False" Click="Zuweisen_Click" />
        </StackPanel>

        <!-- Stopps -->
        <Border Style="{StaticResource KarteStyle}">
            <StackPanel Spacing="12">
                <TextBlock Text="Stopps" Style="{StaticResource UeberschriftText}" />
                <Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="14,10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Stopp" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Status" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Fenster" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Tatsächliche Zeit" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                    </Grid>
                </Border>
                <ItemsControl x:Name="StoppListe">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:TourDetailStoppZeile">
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Titel}" Style="{StaticResource NormalText}" />
                                        <TextBlock Text="{x:Bind Unterzeile}" Style="{StaticResource HinweisText}" FontSize="13" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Status}" Style="{StaticResource NormalText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Fenster}" Style="{StaticResource NormalText}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="3" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Zeit}" Style="{StaticResource NormalText}" />
                                        <TextBlock Text="{x:Bind Verspaetung}" Style="{StaticResource FehlerText}" FontSize="13"
                                                   Visibility="{x:Bind VerspaetungSichtbar}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="StoppLeerText" Style="{StaticResource HinweisText}" Visibility="Collapsed"
                           Text="Diese Tour hat noch keine Stopps." />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
