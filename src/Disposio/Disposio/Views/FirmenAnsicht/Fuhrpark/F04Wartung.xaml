<?xml version="1.0" encoding="utf-8"?>
<!-- F04 „Wartung“ (US-05, #89–#91): offene Wartungstermine mit Ampel (überfällig / bald fällig / geplant)
     und die Wartungshistorie je Fahrzeug. Anlegen und Erledigen geschieht im Formular F05. -->
<UserControl
    x:Class="Disposio.Views.F04Wartung"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Disposio.Views">

    <StackPanel Spacing="18">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ProgressRing x:Name="LadeAnzeige" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" Style="{StaticResource HinweisText}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="NeuLadenButton" Grid.Column="1" Content="Erneut laden"
                    Style="{StaticResource DashboardButton}" Click="NeuLaden_Click" />
            <Button x:Name="NachtragenButton" Grid.Column="2" Content="Durchgeführte Wartung eintragen"
                    Style="{StaticResource DashboardButton}" Click="Nachtragen_Click" />
            <Button x:Name="AnlegenButton" Grid.Column="3" Content="+ Wartungstermin anlegen"
                    Style="{StaticResource PrimaryButton}" Click="Anlegen_Click" />
        </Grid>

        <!-- #89 Termine, #90 farbliche Hervorhebung: farbiger Balken links und Ampel-Kennzeichnung mit Text. -->
        <Border Style="{StaticResource KarteStyle}">
            <StackPanel Spacing="12">
                <TextBlock Text="Offene Wartungstermine" Style="{StaticResource UeberschriftText}" />
                <StackPanel x:Name="Legende" Orientation="Horizontal" Spacing="18" />

                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,0,0,10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="250" />
                        </Grid.ColumnDefinitions>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="1.1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Fahrzeug" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Wartungsart" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Fällig" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="Status" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="Bemerkung" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                        </Grid>
                        <TextBlock Grid.Column="1" Text="Aktionen" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                    </Grid>
                </Border>

                <ItemsControl x:Name="TerminListe">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:WartungsterminZeile">
                            <!-- Der linke Rand trägt die Ampelfarbe, damit Dringendes beim Überfliegen auffällt. -->
                            <Border BorderBrush="{x:Bind AmpelFarbe}" BorderThickness="4,0,0,0" Margin="0,6,0,0"
                                    Background="{x:Bind Hintergrund}" CornerRadius="6" Padding="10,10">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="250" />
                                    </Grid.ColumnDefinitions>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="1.1*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Kennzeichen}" Style="{StaticResource NormalText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Wartungsart}" Style="{StaticResource NormalText}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Faellig}" Style="{StaticResource NormalText}" />
                                            <TextBlock Text="{x:Bind FaelligZusatz}" Style="{StaticResource HinweisText}" />
                                        </StackPanel>
                                        <Border Grid.Column="3" BorderBrush="{x:Bind AmpelFarbe}" BorderThickness="1"
                                                CornerRadius="14" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="9" Height="9" Fill="{x:Bind AmpelFarbe}" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind AmpelText}" FontSize="13" Foreground="{StaticResource TextBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Column="4" Text="{x:Bind Bemerkung}" Style="{StaticResource HinweisText}" VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="Erledigt eintragen" Style="{StaticResource DashboardButton}"
                                                MinHeight="34" Padding="12,4" FontSize="13" Click="Erledigen_Click"
                                                AutomationProperties.Name="{x:Bind ErledigenBeschreibung}" />
                                        <Button Content="Entfernen" Style="{StaticResource DashboardButton}"
                                                MinHeight="34" Padding="12,4" FontSize="13" Click="Entfernen_Click"
                                                AutomationProperties.Name="{x:Bind EntfernenBeschreibung}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="TermineLeerText" Visibility="Collapsed" Style="{StaticResource HinweisText}"
                           Text="Keine offenen Wartungstermine. Legen Sie einen mit „+ Wartungstermin anlegen“ an." />
            </StackPanel>
        </Border>

        <!-- #91 Wartungshistorie, auf Wunsch nur für ein Fahrzeug. -->
        <Border Style="{StaticResource KarteStyle}">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Wartungshistorie" Style="{StaticResource UeberschriftText}" VerticalAlignment="Center" />
                    <ComboBox x:Name="HistorieFilterBox" Grid.Column="1" Style="{StaticResource FormComboBox}"
                              AutomationProperties.Name="Wartungshistorie nach Fahrzeug filtern"
                              SelectionChanged="HistorieFilter_SelectionChanged" />
                </Grid>

                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="0.7*" />
                            <ColumnDefinition Width="1.6*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Datum" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Fahrzeug" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Wartungsart" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Kilometerstand" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="Kosten" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="5" Text="Bemerkung" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                    </Grid>
                </Border>

                <ItemsControl x:Name="HistorieListe">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:WartungHistorieZeile">
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="0.7*" />
                                        <ColumnDefinition Width="1.6*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Datum}" Style="{StaticResource NormalText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Kennzeichen}" Style="{StaticResource NormalText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Wartungsart}" Style="{StaticResource NormalText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Kilometerstand}" Style="{StaticResource NormalText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Kosten}" Style="{StaticResource NormalText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind Bemerkung}" Style="{StaticResource HinweisText}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="HistorieLeerText" Visibility="Collapsed" Style="{StaticResource HinweisText}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
