<?xml version="1.0" encoding="utf-8"?>
<!-- F01 „Fuhrparkübersicht“: alle Fahrzeuge des eigenen Unternehmens, der Weg zu „Fahrzeug anlegen / bearbeiten“ (F02)
     und „Inaktiv setzen“. Inaktive (ausgemusterte) Fahrzeuge sind zuerst ausgeblendet. -->
<UserControl
    x:Class="Disposio.Views.F01Fuhrpark"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Disposio.Views">

    <StackPanel Spacing="18">
        <!-- Status links, Knöpfe rechts. Der Status erklärt Laden, Fehler und gerade Gespeichertes. -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ProgressRing x:Name="LadeAnzeige" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" Style="{StaticResource HinweisText}" VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="InaktiveButton" Grid.Column="1" Visibility="Collapsed"
                    Style="{StaticResource DashboardButton}" Click="InaktiveUmschalten_Click" />
            <Button x:Name="NeuLadenButton" Grid.Column="2" Content="Erneut laden"
                    Style="{StaticResource DashboardButton}" Click="NeuLaden_Click" />
            <Button x:Name="AnlegenButton" Grid.Column="3" Content="+ Fahrzeug anlegen"
                    Style="{StaticResource PrimaryButton}" Click="Anlegen_Click" />
        </Grid>

        <Border Style="{StaticResource KarteStyle}">
            <StackPanel Spacing="12">
                <TextBlock Text="Fahrzeuge" Style="{StaticResource UeberschriftText}" />

                <!-- Kopfzeile und Zeilen haben dieselben Spaltenbreiten, deshalb stehen die Spalten untereinander.
                     Rechts steht eine feste Spalte für die Knöpfe, links die Daten. -->
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="230" />
                        </Grid.ColumnDefinitions>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="0.9*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Kennzeichen" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Klasse / Aufbau" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Hersteller / Modell" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="Kilometerstand" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="Kapazität" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="5" Text="Status" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                        </Grid>
                        <TextBlock Grid.Column="1" Text="Aktionen" Style="{StaticResource HinweisText}" FontWeight="SemiBold" />
                    </Grid>
                </Border>

                <ItemsControl x:Name="FahrzeugListe">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:FahrzeugZeile">
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="230" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Inaktive Fahrzeuge erscheinen blasser. Die Knöpfe rechts bleiben gut lesbar. -->
                                    <Grid ColumnSpacing="16" Opacity="{x:Bind Deckkraft}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1.3*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="0.9*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Kennzeichen}" Style="{StaticResource NormalText}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Abteilung}" Style="{StaticResource HinweisText}"
                                                       Visibility="{x:Bind AbteilungSichtbarkeit}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind KlasseUndAufbau}" Style="{StaticResource NormalText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind HerstellerUndModell}" Style="{StaticResource NormalText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind Kilometerstand}" Style="{StaticResource NormalText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind Kapazitaet}" Style="{StaticResource NormalText}" VerticalAlignment="Center" />
                                        <Border Grid.Column="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="14" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Status}" FontSize="13" Foreground="{StaticResource TextBrush}" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="Bearbeiten" Style="{StaticResource DashboardButton}"
                                                MinHeight="34" Padding="12,4" FontSize="13" Click="Bearbeiten_Click"
                                                AutomationProperties.Name="{x:Bind BearbeitenBeschreibung}" />
                                        <Button Content="{x:Bind AktivUmschaltenText}" Style="{StaticResource DashboardButton}"
                                                MinHeight="34" Padding="12,4" FontSize="13" Click="AktivUmschalten_Click"
                                                AutomationProperties.Name="{x:Bind AktivUmschaltenBeschreibung}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="LeerText" Visibility="Collapsed" Style="{StaticResource HinweisText}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
