<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Disposio.Views.DashboardAnsicht"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Dark"
    FontFamily="Segoe UI"
    FontSize="16">

    <Page.Resources>
        <!-- Dieselben Farbobjekte werden in der Seite und ihren Dialogen verwendet.
             Eine Farbänderung aktualisiert deshalb alle passenden Elemente gemeinsam. -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#101319" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#262930" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#262930" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3D414A" />
        <SolidColorBrush x:Key="TextBrush" Color="#F0F2F6" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#BDC4D1" />
        <SolidColorBrush x:Key="InputBrush" Color="#262930" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7B2CBF" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#8B4BC9" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#6925A2" />
        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#7B2CBF" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#8B4BC9" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#6925A2" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#7B2CBF" />
        <!-- Wie in der Firmenansicht (Stil der Fahrer-App): graue Statusfläche und Rot für Fehler. -->
        <SolidColorBrush x:Key="StatusBoxBrush" Color="#F0F1F3" />
        <SolidColorBrush x:Key="LateBrush" Color="#C62828" />

        <Style x:Key="DashboardButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ButtonBorder.Opacity" Value="0.85" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ButtonBorder.Opacity" Value="0.7" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="ButtonBorder.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DashboardButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="FormComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="20,18" />
            <Setter Property="MinHeight" Value="104" />
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowSizes">
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AccountPanel.Visibility" Value="Collapsed" />
                        <Setter Target="CompactAccount.Visibility" Value="Visible" />
                        <Setter Target="MainContent.Padding" Value="20,20" />
                        <Setter Target="PageTitle.FontSize" Value="24" />
                        <Setter Target="HeaderTitleColumn.Width" Value="*" />
                        <Setter Target="AppearanceControls.(Grid.Row)" Value="1" />
                        <Setter Target="AppearanceControls.(Grid.Column)" Value="0" />
                        <Setter Target="AppearanceControls.HorizontalAlignment" Value="Left" />
                        <Setter Target="AppearanceControls.Margin" Value="0,18,0,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Desktop">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1050" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="WideDesktop">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1450" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="ContentSizes">
                <VisualState x:Name="NarrowContent">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="StatsGrid.RowSpacing" Value="16" />
                        <Setter Target="CustomerCard.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="TrialCard.(Grid.Row)" Value="1" />
                        <Setter Target="TrialCard.(Grid.Column)" Value="0" />
                        <Setter Target="TrialCard.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="UserCard.(Grid.Row)" Value="2" />
                        <Setter Target="UserCard.(Grid.Column)" Value="0" />
                        <Setter Target="UserCard.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="CreateCustomerButton.(Grid.Row)" Value="1" />
                        <Setter Target="CreateCustomerButton.(Grid.Column)" Value="0" />
                        <Setter Target="CreateCustomerButton.Margin" Value="0,16,0,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="RegularContent">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="680" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RailColumn" Width="140" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Obere Leiste wie in der Firmenansicht: Logo, Bereich, rechts Konto und Abmelden. -->
        <Border Grid.ColumnSpan="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="DISPOSIO" FontSize="18" FontWeight="Bold" CharacterSpacing="80"
                           VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Grid.Column="1" Text="ADMIN-BEREICH" FontSize="12" CharacterSpacing="160" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}" />
                <Border x:Name="AccountPanel" Grid.Column="3" Background="{StaticResource StatusBoxBrush}"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="3,0,0,0"
                        Padding="12,6" VerticalAlignment="Center" MaxWidth="420">
                    <StackPanel>
                        <TextBlock x:Name="AccountNameText" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}" />
                        <TextBlock x:Name="AccountRoleText" FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Border>
                <HyperlinkButton Grid.Column="4" Content="Abmelden" Click="Logout_Click" Padding="0" VerticalAlignment="Center"
                                 Foreground="{StaticResource MutedTextBrush}" FontSize="14" />
            </Grid>
        </Border>

        <!-- Schmale Navigationsleiste mit Symbolen wie in der Firmenansicht. Den aktiven Punkt setzt ZeigeBereich. -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel Padding="6,10,6,14" Spacing="4">
                <!-- Reißzwecke: angeheftet = breit mit Namen, gelöst = schmal nur mit Symbolen. -->
                <Button x:Name="PinButton" Click="Pin_Click" HorizontalAlignment="Center" Width="40" Height="36"
                        MinHeight="0" Padding="0" Background="Transparent" BorderThickness="0"
                        Style="{StaticResource DashboardButton}">
                    <FontIcon x:Name="PinSymbol" Glyph="&#xE718;" FontSize="16" Foreground="{StaticResource MutedTextBrush}" />
                </Button>
                <Border Height="1" Margin="0,8,0,8" Background="{StaticResource BorderBrush}" />
                <Border x:Name="KundenMenu" Background="Transparent" CornerRadius="4" Padding="2,6"
                        Tapped="KundenMenu_Tapped" AutomationProperties.Name="Kunden" ToolTipService.ToolTip="Kunden">
                    <StackPanel x:Name="KundenInhalt" Spacing="10" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border x:Name="KundenPille" Width="56" Height="30" CornerRadius="15" HorizontalAlignment="Center">
                            <FontIcon x:Name="KundenSymbol" Glyph="&#xE716;" FontSize="18" />
                        </Border>
                        <TextBlock x:Name="KundenText" Text="Kunden" FontSize="14" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Height="1" Margin="18,0" Background="{StaticResource BorderBrush}" />
                <Border x:Name="ProtokollMenu" Background="Transparent" CornerRadius="4" Padding="2,6"
                        Tapped="ProtokollMenu_Tapped" AutomationProperties.Name="Aktionsprotokoll" ToolTipService.ToolTip="Aktionsprotokoll">
                    <StackPanel x:Name="ProtokollInhalt" Spacing="10" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border x:Name="ProtokollPille" Width="56" Height="30" CornerRadius="15" HorizontalAlignment="Center">
                            <FontIcon x:Name="ProtokollSymbol" Glyph="&#xE81C;" FontSize="18" />
                        </Border>
                        <TextBlock x:Name="ProtokollText" Text="Aktionsprotokoll" FontSize="14" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="MainContent" Padding="28,22,28,28" Spacing="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="HeaderTitleColumn" Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Text="Unsere Kunden" FontSize="28"
                                   FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock x:Name="PageSubtitle" Text="Kunden anlegen, bearbeiten und in ihre Ansicht springen."
                                   FontSize="15" Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" Margin="0,4,20,0" />
                    </StackPanel>
                    <StackPanel x:Name="AppearanceControls" Grid.Column="1" Orientation="Horizontal"
                                Spacing="18" VerticalAlignment="Top" HorizontalAlignment="Right">
                        <ComboBox x:Name="ColorCombo" Width="160" Style="{StaticResource FormComboBox}"
                                  SelectionChanged="ColorCombo_SelectionChanged"
                                  AutomationProperties.Name="Akzentfarbe" ToolTipService.ToolTip="Akzentfarbe wählen">
                            <ComboBoxItem Content="Disposio-Blau" Tag="#263749" />
                            <ComboBoxItem Content="Pink-Rot" Tag="#FF004D" />
                            <ComboBoxItem Content="Blau" Tag="#007BFF" />
                            <ComboBoxItem Content="Grün" Tag="#00C853" />
                            <ComboBoxItem Content="Orange" Tag="#FF9100" />
                            <ComboBoxItem Content="Lila" Tag="#7B2CBF" />
                        </ComboBox>
                        <Border Width="72" Height="50">
                            <ToggleSwitch x:Name="ModeSwitch" OnContent="" OffContent="" MinWidth="0"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5" Toggled="ModeSwitch_Toggled"
                                          AutomationProperties.Name="Hellmodus"
                                          ToolTipService.ToolTip="Hell- und Dunkelmodus umschalten">
                                <ToggleSwitch.RenderTransform>
                                    <ScaleTransform ScaleX="1.6" ScaleY="1.6" />
                                </ToggleSwitch.RenderTransform>
                            </ToggleSwitch>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid x:Name="CompactAccount" Visibility="Collapsed" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="DISPOSIO" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock x:Name="CompactAccountText" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                    <HyperlinkButton Grid.Column="1" Content="Abmelden" Click="Logout_Click" Padding="4,0"
                                     Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                </Grid>

                <!-- Systemzustand: Ampel-Kacheln für kritische Fehler (Datenbank, Neon Functions, Übersetzung …).
                     Bleibt in beiden Bereichen (Kunden und Aktionsprotokoll) sichtbar. Inhalt: SystemzustandAnzeige.cs -->
                <Border x:Name="SystemzustandHost" />

                <!-- Der Status erklärt Laden/Fehler. Erneut laden holt den aktuellen Stand aus Neon. -->
                <Grid x:Name="CustomerStatusRow" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid ColumnSpacing="12" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing x:Name="DatabaseLoadingIndicator" Width="22" Height="22"
                                      IsActive="False" Visibility="Collapsed" />
                        <TextBlock x:Name="DatabaseStatusText" Grid.Column="1" Text="Unternehmen werden geladen …"
                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </Grid>
                    <Button x:Name="ReloadCustomersButton" Grid.Column="1" Content="Erneut laden"
                            Style="{StaticResource DashboardButton}" Click="ReloadCustomers_Click" />
                </Grid>

                <Grid x:Name="StatsGrid" ColumnSpacing="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="CustomerCard" Style="{StaticResource StatCard}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="CustomerCountText" Text="–" FontSize="30" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="Kunden" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="TrialCard" Grid.Column="1" Style="{StaticResource StatCard}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="TrialCountText" Text="–" FontSize="30" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="in Testphase" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="UserCard" Grid.Column="2" Style="{StaticResource StatCard}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="UserCountText" Text="–" FontSize="30" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="Benutzer" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="CustomerListCard" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="20,18">
                    <StackPanel Spacing="24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Alle Kunden" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                            <Button x:Name="CreateCustomerButton" Grid.Column="1" Content="+ Kunde anlegen" Style="{StaticResource PrimaryButton}"
                                    Click="CreateCustomer_Click" Margin="16,0,0,0" />
                        </Grid>
                        <TextBlock x:Name="EmptyCustomersText" Text="Noch keine Unternehmen vorhanden. Lege das erste Unternehmen an."
                                   Visibility="Collapsed" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                        <!-- Durch horizontales Scrollen bleiben auch in kleinen Fenstern alle Spalten erreichbar. -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                                      VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                            <StackPanel MinWidth="1170">
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                        Padding="12,0,12,16">
                                    <Grid ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" MinWidth="250" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="500" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Kunde" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Column="1" Text="Kundenadmin" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Column="2" Text="Benutzer" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Column="3" Text="Status" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                                    </Grid>
                                </Border>
                                <ItemsControl x:Name="KundenItems" ItemsSource="{x:Bind Kunden}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,16">
                                                <Grid ColumnSpacing="18">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="170" />
                                                        <ColumnDefinition Width="*" MinWidth="250" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="500" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Opacity: Gesperrte Kunden (Status „Inaktiv“) erscheinen blasser. -->
                                                    <StackPanel VerticalAlignment="Center" Spacing="2" Opacity="{Binding Deckkraft}">
                                                        <TextBlock Text="{Binding Firmenname}" FontSize="18" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}"
                                                                   ToolTipService.ToolTip="{Binding Firmenname}" />
                                                        <TextBlock Text="{Binding Kennung}" FontSize="14" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource MutedTextBrush}" ToolTipService.ToolTip="{Binding Kennung}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding AdminEmail}" FontSize="17" Opacity="{Binding Deckkraft}"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource TextBrush}" ToolTipService.ToolTip="{Binding AdminEmail}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Benutzer}" FontSize="17" Opacity="{Binding Deckkraft}"
                                                               VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                                                    <Border Grid.Column="3" BorderBrush="{Binding StatusBorderBrush}" BorderThickness="1"
                                                            CornerRadius="4" Padding="14,5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Status}" FontSize="14" Foreground="{StaticResource TextBrush}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="14"
                                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Content="Kundenadmin anlegen" Style="{StaticResource DashboardButton}" Click="CreateKundenadmin_Click"
                                                                AutomationProperties.HelpText="{Binding Firmenname}" />
                                                        <Button Content="Bearbeiten" Style="{StaticResource DashboardButton}" Click="EditCustomer_Click"
                                                                AutomationProperties.HelpText="{Binding Firmenname}" />
                                                        <Button Content="Einloggen" Style="{StaticResource PrimaryButton}" Click="LoginCustomer_Click"
                                                                AutomationProperties.HelpText="{Binding Firmenname}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="CustomerFooterText" Text="Unternehmen werden dauerhaft gespeichert."
                           FontSize="13" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                <!-- Aktionsprotokoll aller Firmen. Wird beim Klick auf den Menüpunkt gefüllt. -->
                <Border x:Name="ProtokollHost" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
