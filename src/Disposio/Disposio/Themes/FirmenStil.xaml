<?xml version="1.0" encoding="utf-8"?>
<!-- Design im Stil der Fahrer-App (disposio_fahrer/lib/theme/disposio_theme.dart):
     Dunkelblau #263749 als Hauptfarbe, ruhige Grautöne, fast eckige Formen (4 px), Statuszeile mit Strich links.
     Die Startwerte hier sind der Dark Mode; Hell/Dunkel setzt FirmenAnsicht.ApplyAppearance.
     Gemeinsamer Stil aller Firmenansichten. Jede Ansicht (auch in einer eigenen XAML-Datei)
     kann diese Farben und Stile mit {StaticResource Name} verwenden. Die Firmenansicht ändert beim
     Wechsel von Hell/Dunkel oder Akzentfarbe nur die Farbe dieser Objekte; alles passt sich an. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="BackgroundBrush" Color="#12161C" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#1B2129" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1B2129" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2E3641" />
    <SolidColorBrush x:Key="TextBrush" Color="#E6EAF0" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9AA3B0" />
    <SolidColorBrush x:Key="InputBrush" Color="#12161C" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF7B7B" />
    <SolidColorBrush x:Key="AccentBrush" Color="#A9C4E4" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#0F1A26" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#B9CFE9" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#98B6D9" />
    <!-- Graue Statuszeile ("Unterwegs · GPS an") und Etikett "Erledigt", wie in der Fahrer-App. -->
    <SolidColorBrush x:Key="StatusBoxBrush" Color="#232A33" />
    <!-- Verspätung, z. B. "ETA 16:03 · verspätet". -->
    <SolidColorBrush x:Key="LateBrush" Color="#FF7B7B" />

    <!-- Karte: weißer bzw. dunkelgrauer Kasten mit feinem Rand und fast eckigen Ecken, wie in der Fahrer-App. -->
    <Style x:Key="KarteStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="20,18" />
    </Style>

    <Style x:Key="UeberschriftText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="NormalText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="HinweisText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    </Style>

    <Style x:Key="FehlerText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
    </Style>

    <!-- Beschriftung über einem Eingabefeld. Pflichtfelder bekommen ein * im Text. -->
    <Style x:Key="FeldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="FormDatePicker" TargetType="CalendarDatePicker">
        <Setter Property="Background" Value="{StaticResource InputBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="FormTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource InputBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="FormComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource InputBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="DashboardButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ButtonBorder.Opacity" Value="0.85" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ButtonBorder.Opacity" Value="0.7" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ButtonBorder.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DashboardButton}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Menüpunkte: ohne Rahmen, linksbündig. Beim Überfahren erscheint ein dünner Rahmen;
         der aktive Menüpunkt bekommt im Code die Akzentfarbe. -->
    <Style x:Key="MenuButton" TargetType="Button" BasedOn="{StaticResource DashboardButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ButtonBorder.BorderThickness" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ButtonBorder.BorderThickness" Value="1" />
                                        <Setter Target="ButtonBorder.Opacity" Value="0.7" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ButtonBorder.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ── Bausteine aus der Fahrer-App ─────────────────────────────────────────────── -->

    <!-- Graue Statuszeile mit Strich links, z. B. "Unterwegs · GPS an · zuletzt 19:56". -->
    <Style x:Key="StatusZeile" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource StatusBoxBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- Hinweis/Problem in derselben Form, aber mit rotem Strich (z. B. Stau, Verspätung). -->
    <Style x:Key="WarnZeile" TargetType="Border" BasedOn="{StaticResource StatusZeile}">
        <Setter Property="BorderBrush" Value="{StaticResource LateBrush}" />
    </Style>

    <Style x:Key="StatusZeileText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <!-- Status-Etiketten wie StatusBadge der Fahrer-App: aktiv gefüllt, offen umrandet, erledigt grau.
         Verwendung: <Border Style="{StaticResource BadgeAktiv}"><TextBlock Text="Unterwegs" Style="{StaticResource BadgeAktivText}" /></Border> -->
    <Style x:Key="BadgeOffen" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="BadgeAktiv" TargetType="Border" BasedOn="{StaticResource BadgeOffen}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    </Style>

    <Style x:Key="BadgeErledigt" TargetType="Border" BasedOn="{StaticResource BadgeOffen}">
        <Setter Property="Background" Value="{StaticResource StatusBoxBrush}" />
    </Style>

    <Style x:Key="BadgeOffenText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>

    <Style x:Key="BadgeAktivText" TargetType="TextBlock" BasedOn="{StaticResource BadgeOffenText}">
        <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
    </Style>

    <Style x:Key="BadgeErledigtText" TargetType="TextBlock" BasedOn="{StaticResource BadgeOffenText}">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    </Style>

    <!-- "ETA 14:35" in der Hauptfarbe, "ETA 16:03 · verspätet" in Rot. -->
    <Style x:Key="EtaText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>

    <Style x:Key="EtaVerspaetetText" TargetType="TextBlock" BasedOn="{StaticResource EtaText}">
        <Setter Property="Foreground" Value="{StaticResource LateBrush}" />
    </Style>

    <!-- Große Kachel mit Symbol und Text (wie Angekommen/Entladen/Pause/Problem in der Fahrer-App). -->
    <Style x:Key="KachelButton" TargetType="Button" BasedOn="{StaticResource DashboardButton}">
        <Setter Property="MinHeight" Value="72" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Menüpunkt der schmalen Navigationsleiste: Symbol über Name, ohne Rahmen. -->
    <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource MenuButton}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="2,6" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
</ResourceDictionary>