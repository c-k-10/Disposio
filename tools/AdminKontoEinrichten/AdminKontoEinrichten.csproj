<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Im Repository liegt das Werkzeug unter tools/. Der zweite Pfad ist nur
         für das isolierte Prüfen vor dem Übernehmen in das Originalprojekt. -->
    <SharedServicesPath Condition="Exists('..\..\src\Disposio\Disposio\Services\Database.cs')">..\..\src\Disposio\Disposio\Services</SharedServicesPath>
    <SharedServicesPath Condition="'$(SharedServicesPath)' == ''">..\Disposio\Services</SharedServicesPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <Compile Include="$(SharedServicesPath)\Database.cs" Link="Services\Database.cs" />
    <Compile Include="$(SharedServicesPath)\NeonSqlClient.cs" Link="Services\NeonSqlClient.cs" />
  </ItemGroup>
</Project>
